PORT=3000
DATABASE_URL="postgresql://postgres:000000@localhost:5432/roadtoschool?schema=public"

# Initial System Admin Bootstrap (Local Development only)
BOOTSTRAP_ADMIN_EMAIL=admin@r2s.com
BOOTSTRAP_ADMIN_PASSWORD=Pass@123

# Authentication JWT & Tokens
AUTH_JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# OTP Configuration
AUTH_OTP_LENGTH=6
AUTH_OTP_TTL_SECONDS=300

# Notification Channels
AUTH_EMAIL_MODE=console
AUTH_SMS_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RoadToSchool <no-reply@r2s.com>

# ==============================================================================
# CLOUDINARY CONFIGURATION (SCHOOL IMAGE STORAGE)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# VietMap Services (VRP, TSP, Routing)
VIETMAP_SERVICES_KEY=

# Trip Operation Mode (LIVE: Enforce 15m ready gate & 5m start gate | TEST: Allow anytime testing)
TRIP_OPERATION_MODE=TEST

# Notifications: disabled by default. Enable only after EAS/FCM/APNs setup and an approved delivery scope.
PUSH_NOTIFICATIONS_ENABLED=false
# Optional when enhanced Expo Push security is enabled; never expose in a client build.
EXPO_PUSH_ACCESS_TOKEN=

+import { useState, type ReactNode } from 'react';
+import { Pressable, StyleSheet, Text, View } from 'react-native';
+import Ionicons from '@expo/vector-icons/Ionicons';
+import { UserAvatar } from '@/components/user-avatar';
+import { parentHomeStyles } from '@/components/parent/home-styles';
+import { colors } from '@/constants/theme';
+
+type Props = {
+  studentName: string;
+  avatarUrl?: string | null;
+  schoolName: string;
+  status: { label: string; bg: string; text: string };
+  children: ReactNode;
+};
+
+/** Owns disclosure only; the parent keeps trip data, permissions and action handlers. */
+export function ParentTripCard({ studentName, avatarUrl, schoolName, status, children }: Props) {
+  const [expanded, setExpanded] = useState(false);
+
+  return (
+    <View style={[parentHomeStyles.tripCard, styles.card]}>
+      <Pressable
+        accessibilityRole="button"
+        accessibilityLabel={`${studentName}, ${schoolName}, ${status.label}`}
+        accessibilityHint={expanded ? 'Thu gọn thông tin chuyến xe' : 'Mở rộng thông tin chuyến xe'}
+        accessibilityState={{ expanded }}
+        aria-expanded={expanded}
+        onPress={() => setExpanded(value => !value)}
+        style={({ pressed }) => [styles.summary, pressed && styles.pressed]}
+      >
+        {/* Student photo comes from the card, independently of the parent's profile photo. */}
+        <UserAvatar avatarUrl={avatarUrl} fullName={studentName} size={48} />
+        <View style={parentHomeStyles.identity}>
+          <View style={styles.nameStatusRow}>
+            <Text style={[parentHomeStyles.studentName, styles.name]}>{studentName}</Text>
+            <View style={styles.status}>
+              <View style={[parentHomeStyles.statusPill, { backgroundColor: status.bg }]}>
+                <Text style={[parentHomeStyles.statusPillText, { color: status.text }]}>
+                  {status.label}
+                </Text>
+              </View>
+            </View>
+          </View>
+          <View style={styles.schoolRow}>
+            <Text style={[parentHomeStyles.metaText, styles.school]}>{schoolName}</Text>
+            <Ionicons
+              name={expanded ? 'chevron-up' : 'chevron-down'}
+              size={18}
+              color={colors.mutedText}
+              accessible={false}
+            />
+          </View>
+        </View>
+      </Pressable>
+      {expanded && <View style={styles.details}>{children}</View>}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  card: {
+    padding: 0,
+    gap: 0,
+  },
+  summary: {
+    minHeight: 80,
+    padding: 16,
+    borderRadius: 20,
+    flexDirection: 'row',
+    alignItems: 'flex-start',
+    gap: 12,
+  },
+  nameStatusRow: {
+    flexDirection: 'row',
+    alignItems: 'flex-start',
+    gap: 8,
+  },
+  name: {
+    flex: 1,
+    minWidth: 0,
+  },
+  status: {
+    maxWidth: '48%',
+    flexShrink: 0,
+  },
+  schoolRow: {
+    flexDirection: 'row',
+    alignItems: 'center',
+    gap: 8,
+    marginTop: 4,
+  },
+  school: {
+    flex: 1,
+    minWidth: 0,
+    marginTop: 0,
+  },
+  details: {
+    borderTopWidth: StyleSheet.hairlineWidth,
+    borderTopColor: colors.border,
+    padding: 16,
+    gap: 14,
+  },
+  pressed: {
+    opacity: 0.75,
+  },
+});

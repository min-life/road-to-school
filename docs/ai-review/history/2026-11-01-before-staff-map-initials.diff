diff --git a/mobile/utils/staff-map-marker.ts b/mobile/utils/staff-map-marker.ts
new file mode 100644
--- /dev/null
+++ b/mobile/utils/staff-map-marker.ts
@@ -0,0 +1,23 @@
+import { mapPinSvg } from './child-map-marker';
+
+/** Same silhouette/face as the Parent pin; order is text, never interpolated HTML. */
+export const numberedMapPinScript = `
+  window.createNumberedMapPin = function(order) {
+    var root = document.createElement('div');
+    root.className = 'child-map-pin';
+    root.setAttribute('aria-hidden', 'true');
+    root.innerHTML = ${JSON.stringify(mapPinSvg)};
+    var face = document.createElement('div');
+    face.className = 'child-map-pin-face';
+    var label = document.createElement('span');
+    label.textContent = String(order);
+    face.appendChild(label);
+    root.appendChild(face);
+    return root;
+  };
+`;
+
+// Fixed outline icons only for staff; the Parent's existing emoji markers stay intact.
+const svgStart = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" style="vertical-align:middle" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">';
+export const staffSchoolSvg = svgStart + '<path d="M3 21V9l9-6 9 6v12H3Z M9 21v-7h6v7 M3 10h18 M7 12v3 M17 12v3"/><circle cx="12" cy="7" r="1"/></svg>';
+export const staffBusSvg = svgStart + '<rect x="5" y="3" width="14" height="16" rx="3"/><path d="M5 11h14 M9 3v8 M15 3v8 M8 19v2 M16 19v2"/><circle cx="8" cy="15" r="1"/><circle cx="16" cy="15" r="1"/></svg>';
diff --git a/mobile/utils/trip-map-layout.ts b/mobile/utils/trip-map-layout.ts
new file mode 100644
--- /dev/null
+++ b/mobile/utils/trip-map-layout.ts
@@ -0,0 +1,8 @@
+import type { Role } from '../services/api-client';
+
+/** Reserve space only for a role/status branch that actually renders footer content. */
+export function hasTripBottomAction(role: Role | undefined, status: string | undefined): boolean {
+  return role === 'DRIVER'
+    ? status === 'SCHEDULED' || status === 'IN_PROGRESS'
+    : role === 'BUS_ATTENDANT' && status === 'SCHEDULED';
+}
diff --git a/mobile/scripts/trip-map-layout.test.ts b/mobile/scripts/trip-map-layout.test.ts
new file mode 100644
--- /dev/null
+++ b/mobile/scripts/trip-map-layout.test.ts
@@ -0,0 +1,30 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { hasTripBottomAction } from '../utils/trip-map-layout';
+
+// Role/status primitives only; no Trip/User records or API responses.
+describe('Trip map footer visibility', () => {
+  it('never reserves an operation footer for Parent', () => {
+    for (const status of [undefined, 'SCHEDULED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED']) {
+      assert.equal(hasTripBottomAction('PARENT', status), false);
+    }
+  });
+  it('shows the driver footer only where an existing action is rendered', () => {
+    assert.equal(hasTripBottomAction('DRIVER', 'SCHEDULED'), true);
+    assert.equal(hasTripBottomAction('DRIVER', 'IN_PROGRESS'), true);
+    for (const status of [undefined, 'COMPLETED', 'CANCELLED', 'UNKNOWN']) {
+      assert.equal(hasTripBottomAction('DRIVER', status), false);
+    }
+  });
+  it('does not leave an empty attendant footer during a running trip', () => {
+    assert.equal(hasTripBottomAction('BUS_ATTENDANT', 'SCHEDULED'), true);
+    for (const status of [undefined, 'IN_PROGRESS', 'COMPLETED', 'CANCELLED']) {
+      assert.equal(hasTripBottomAction('BUS_ATTENDANT', status), false);
+    }
+  });
+  it('does not grant footer controls to an unknown or admin role', () => {
+    for (const role of [undefined, 'SYSTEM_ADMIN', 'SCHOOL_ADMIN'] as const) {
+      assert.equal(hasTripBottomAction(role, 'SCHEDULED'), false);
+    }
+  });
+});
diff --git a/mobile/scripts/staff-map-marker.test.ts b/mobile/scripts/staff-map-marker.test.ts
new file mode 100644
--- /dev/null
+++ b/mobile/scripts/staff-map-marker.test.ts
@@ -0,0 +1,57 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { Script } from 'node:vm';
+import { mapPinSvg } from '../utils/child-map-marker';
+import { numberedMapPinScript, staffBusSvg, staffSchoolSvg } from '../utils/staff-map-marker';
+
+// Minimal DOM presentation only; no Student/Trip records, locations or API mocks.
+type PresentationElement = {
+  tag: string; className: string; innerHTML: string; textContent: string;
+  attributes: Record<string, string>; children: PresentationElement[];
+  setAttribute: (key: string, value: string) => void;
+  appendChild: (child: PresentationElement) => void;
+};
+
+function markerFactory() {
+  const scope = {
+    window: {} as { createNumberedMapPin: (order: unknown) => PresentationElement },
+    document: { createElement: element },
+  };
+  function element(tag: string): PresentationElement {
+    return { tag, className: '', innerHTML: '', textContent: '', attributes: {} as Record<string, string>,
+      children: [],
+      setAttribute(key: string, value: string) { this.attributes[key] = value; },
+      appendChild(child: PresentationElement) { this.children.push(child); },
+    };
+  }
+  new Script(numberedMapPinScript).runInNewContext(scope);
+  return scope.window.createNumberedMapPin;
+}
+
+describe('Staff pins reuse the unchanged Parent pin frame', () => {
+  it('uses the same SVG, dimensions class and face without a separate avatar store', () => {
+    const root = markerFactory()(2);
+    assert.equal(root.className, 'child-map-pin');
+    assert.equal(root.innerHTML, mapPinSvg);
+    assert.equal(root.attributes['aria-hidden'], 'true');
+    assert.equal(root.children[0].className, 'child-map-pin-face');
+    assert.equal(root.children[0].children[0].textContent, '2');
+  });
+  it('preserves a full multi-digit order instead of an initial', () => {
+    assert.equal(markerFactory()(27).children[0].children[0].textContent, '27');
+  });
+  it('never puts stop labels into HTML', () => {
+    const text = '</span><img src=x onerror=alert(1)>';
+    const root = markerFactory()(text);
+    assert.equal(root.innerHTML, mapPinSvg);
+    assert.equal(root.children[0].children[0].innerHTML, '');
+    assert.equal(root.children[0].children[0].textContent, text);
+  });
+  it('uses fixed outline school/bus graphics without platform-dependent emoji', () => {
+    for (const icon of [staffSchoolSvg, staffBusSvg]) {
+      assert.ok(icon.startsWith('<svg '));
+      assert.ok(icon.includes('stroke="currentColor"'));
+      assert.equal(/🏫|🚌|<script|<foreignObject|<image/i.test(icon), false);
+    }
+  });
+});

diff --git a/api/src/trips/trip-synchronization.spec.ts b/api/src/trips/trip-synchronization.spec.ts
index e69de29..6a0ff80 100644
--- a/api/src/trips/trip-synchronization.spec.ts
+++ b/api/src/trips/trip-synchronization.spec.ts
@@ -0,0 +1,170 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { BadRequestException, ConflictException, ForbiddenException } from '@nestjs/common';
+import { AttendanceStatus, Role, RouteDirection, TripStatus } from '@prisma/client';
+import { TripsService } from './trips.service.js';
+
+// In-memory service tests only: no Nest application, PrismaClient or database connection.
+const user = (role: Role, id = 'reader', schoolId: string | null = 'school') => ({ role, id, schoolId } as any);
+const makeTrip = () => ({
+  id: 'trip', schoolId: 'school', serviceDate: new Date('2026-10-25'),
+  direction: RouteDirection.TO_SCHOOL, status: TripStatus.IN_PROGRESS as TripStatus,
+  assignedVehicleId: 'vehicle', assignedDriverId: 'driver', assignedBusAttendantId: 'attendant',
+  attendantReadyAt: new Date(), arrivedAtSchoolAt: new Date(),
+  assignedVehicle: { id: 'vehicle', licensePlate: 'plate', brand: 'bus', seatCount: 16 },
+  assignedDriver: { id: 'driver', fullName: 'Driver' },
+  assignedBusAttendant: { id: 'attendant', fullName: 'Attendant' },
+  school: { id: 'school', name: 'School', latitude: 1, longitude: 1 },
+  route: { id: 'route', name: 'Route', routePlanId: 'plan', routePlan: { name: 'Plan' }, stops: [] },
+  attendances: [
+    { studentId: 'child-a', status: AttendanceStatus.PRESENT, alightedAt: new Date(), markedAt: null, absenceReason: null },
+    { studentId: 'child-b', status: AttendanceStatus.PRESENT, alightedAt: null, markedAt: null, absenceReason: null },
+    { studentId: 'other', status: AttendanceStatus.ABSENT, alightedAt: null, markedAt: null, absenceReason: 'Private' },
+  ],
+});
+
+describe('Trip synchronization authorization and operation serialization', () => {
+  let trip: ReturnType<typeof makeTrip>;
+  let db: any;
+  let service: TripsService;
+  beforeEach(() => {
+    trip = makeTrip();
+    db = {
+      $queryRaw: vi.fn().mockResolvedValue([]),
+      trip: { findUnique: vi.fn(async () => trip), findMany: vi.fn().mockResolvedValue([]), update: vi.fn() },
+      tripAttendance: { findUnique: vi.fn(), findMany: vi.fn(async () => trip.attendances), update: vi.fn() },
+      parentStudentLink: { findMany: vi.fn().mockResolvedValue([]), findUnique: vi.fn() },
+      user: { findUnique: vi.fn() }, vehicle: { findUnique: vi.fn() },
+      school: { findUnique: vi.fn() },
+      $transaction: vi.fn(async (work: any) => work(db)),
+    };
+    service = new TripsService(db, { get: () => 'TEST' } as any);
+  });
+
+  it.each([
+    [Role.DRIVER, 'wrong', 'school'], [Role.BUS_ATTENDANT, 'wrong', 'school'],
+    [Role.SCHOOL_ADMIN, 'reader', 'other-school'], [Role.SCHOOL_ADMIN, 'reader', null],
+    [Role.PARENT, 'parent', null],
+  ])('denies detail/mobile/state outside object scope for %s (%s/%s)', async (role, id, school) => {
+    const actor = user(role as Role, id as string, school);
+    await expect(service.getTripDetail('trip', actor)).rejects.toBeInstanceOf(ForbiddenException);
+    await expect(service.getMobileTripDetail('trip', actor)).rejects.toBeInstanceOf(ForbiddenException);
+    await expect(service.getOperationalState('trip', actor)).rejects.toBeInstanceOf(ForbiddenException);
+  });
+
+  it.each([
+    [Role.SYSTEM_ADMIN, 'reader'], [Role.SCHOOL_ADMIN, 'reader'],
+    [Role.DRIVER, 'driver'], [Role.BUS_ATTENDANT, 'attendant'],
+  ])('allows authorized detail/state for %s', async (role, id) => {
+    expect((await service.getTripDetail('trip', user(role as Role, id))).id).toBe('trip');
+    expect((await service.getOperationalState('trip', user(role as Role, id))).status).toBe(TripStatus.IN_PROGRESS);
+  });
+
+  it.each([user(Role.SCHOOL_ADMIN, 'reader', 'other'), user(Role.SCHOOL_ADMIN, 'reader', null),
+    user(Role.DRIVER, 'wrong'), user(Role.BUS_ATTENDANT, 'wrong'), user(Role.PARENT)])(
+    'denies roster outside scope: %j', async actor => {
+      await expect(service.getTripAttendance('trip', actor)).rejects.toBeInstanceOf(ForbiddenException);
+    },
+  );
+
+  it('denies a linked child not in this Trip roster', async () => {
+    db.parentStudentLink.findMany.mockResolvedValue([{ studentId: 'not-in-roster' }]);
+    await expect(service.getOperationalState('trip', user(Role.PARENT))).rejects.toBeInstanceOf(ForbiddenException);
+  });
+
+  it('does not turn a missing School Admin scope into a system-wide list', async () => {
+    await expect(service.listTrips({} as any, user(Role.SCHOOL_ADMIN, 'reader', null)))
+      .rejects.toBeInstanceOf(ForbiddenException);
+    expect(db.trip.findMany).not.toHaveBeenCalled();
+  });
+
+  it('returns independent own-child state without other-child data, counts or action flags', async () => {
+    db.parentStudentLink.findMany.mockResolvedValue([{ studentId: 'child-a' }, { studentId: 'child-b' }]);
+    const result = await service.getOperationalState('trip', user(Role.PARENT));
+    expect(result.children.map(child => [child.studentId, child.isAlighted])).toEqual([
+      ['child-a', true], ['child-b', false],
+    ]);
+    expect(result).not.toHaveProperty('totalStudents');
+    expect(result).not.toHaveProperty('canStartTrip');
+    expect(result).not.toHaveProperty('childIsAlighted');
+    expect(JSON.stringify(result)).not.toContain('Private');
+    expect(JSON.stringify(result)).not.toContain('other');
+  });
+
+  it('rechecks assignment on the next read', async () => {
+    await service.getOperationalState('trip', user(Role.DRIVER, 'driver'));
+    trip.assignedDriverId = 'replacement';
+    await expect(service.getOperationalState('trip', user(Role.DRIVER, 'driver'))).rejects.toBeInstanceOf(ForbiddenException);
+    await service.getOperationalState('trip', user(Role.DRIVER, 'replacement'));
+  });
+
+  it('filters persisted Parent schedule by roster even when route stops are empty', async () => {
+    db.parentStudentLink.findUnique.mockResolvedValue({ studentId: 'child-a' });
+    db.school.findUnique.mockResolvedValue(null);
+    (db as any).student = { findUnique: vi.fn().mockResolvedValue({ id: 'child-a', fullName: 'A' }) };
+    await service.getParentStudentSchedule('child-a', '2026-10-25', user(Role.PARENT));
+    expect(db.trip.findMany.mock.calls[0][0].where).toMatchObject({ attendances: { some: { studentId: 'child-a' } } });
+    expect(db.trip.findMany.mock.calls[0][0].where).not.toHaveProperty('route');
+  });
+
+  it.each(['assignment', 'ready', 'start', 'arrival', 'boarding', 'alighting', 'complete'])(
+    'awaits the same parameterized Trip row lock before %s reads its preconditions', async operation => {
+      let release!: () => void;
+      db.$queryRaw.mockImplementation(() => new Promise<void>(resolve => { release = resolve; }));
+      // A transition that completed while waiting must be read after acquiring the lock.
+      trip.status = TripStatus.COMPLETED;
+      const calls: Record<string, () => Promise<any>> = {
+        assignment: () => service.updateTripAssignment('trip', { driverId: 'new' }, user(Role.SYSTEM_ADMIN)),
+        ready: () => service.markAttendantReady('trip', user(Role.BUS_ATTENDANT, 'attendant')),
+        start: () => service.startTrip('trip', user(Role.DRIVER, 'driver')),
+        arrival: () => service.arriveAtSchool('trip', user(Role.DRIVER, 'driver')),
+        boarding: () => service.updateAttendance('trip', 'child-a', { status: AttendanceStatus.PRESENT }, user(Role.BUS_ATTENDANT, 'attendant')),
+        alighting: () => service.updateAlighting('trip', 'child-a', { isAlighted: false }, user(Role.BUS_ATTENDANT, 'attendant')),
+        complete: () => service.completeTrip('trip', user(Role.DRIVER, 'driver')),
+      };
+      const pending = calls[operation]();
+      const assertion = expect(pending).rejects.toBeInstanceOf(BadRequestException);
+      expect(db.trip.findUnique).not.toHaveBeenCalled();
+      const query = db.$queryRaw.mock.calls[0][0];
+      expect(query.sql).toBe('SELECT id FROM trips WHERE id = ? FOR UPDATE');
+      expect(query.values).toEqual(['trip']);
+      release();
+      await assertion;
+      expect(db.trip.update).not.toHaveBeenCalled();
+      expect(db.tripAttendance.update).not.toHaveBeenCalled();
+    },
+  );
+
+  it('rejects Start after a Ready reset or assignment revocation', async () => {
+    trip.status = TripStatus.SCHEDULED;
+    trip.attendantReadyAt = null as any;
+    await expect(service.startTrip('trip', user(Role.DRIVER, 'driver'))).rejects.toBeInstanceOf(BadRequestException);
+    trip.assignedDriverId = 'replacement';
+    await expect(service.startTrip('trip', user(Role.DRIVER, 'driver'))).rejects.toBeInstanceOf(ForbiddenException);
+    expect(db.trip.update).not.toHaveBeenCalled();
+  });
+
+  it('rechecks state so a second device cannot start an already started Trip', async () => {
+    trip.status = TripStatus.SCHEDULED;
+    db.trip.update.mockImplementation(async ({ data }: any) => Object.assign(trip, data));
+    await service.startTrip('trip', user(Role.DRIVER, 'driver'));
+    await expect(service.startTrip('trip', user(Role.DRIVER, 'driver'))).rejects.toBeInstanceOf(BadRequestException);
+    expect(db.trip.update).toHaveBeenCalledTimes(1);
+  });
+
+  it('rejects stale assignment form snapshots instead of overwriting another assignment', async () => {
+    trip.status = TripStatus.SCHEDULED;
+    await expect(service.updateTripAssignment('trip', { driverId: 'new', expectedDriverId: 'old' }, user(Role.SYSTEM_ADMIN)))
+      .rejects.toBeInstanceOf(ConflictException);
+    expect(db.trip.update).not.toHaveBeenCalled();
+  });
+
+  it('resets Ready when changing Attendant under the Trip lock', async () => {
+    trip.status = TripStatus.SCHEDULED;
+    db.user.findUnique.mockResolvedValue({ id: 'next', role: Role.BUS_ATTENDANT, isActive: true, schoolId: 'school' });
+    vi.spyOn(service, 'getTripDetail').mockResolvedValue({ id: 'trip' } as any);
+    await service.updateTripAssignment('trip', { busAttendantId: 'next' }, user(Role.SCHOOL_ADMIN));
+    expect(db.trip.update).toHaveBeenCalledWith({ where: { id: 'trip' }, data: {
+      assignedBusAttendantId: 'next', attendantReadyAt: null,
+    } });
+  });
+});
diff --git a/mobile/hooks/use-active-refresh.ts b/mobile/hooks/use-active-refresh.ts
index e69de29..3428e0b 100644
--- a/mobile/hooks/use-active-refresh.ts
+++ b/mobile/hooks/use-active-refresh.ts
@@ -0,0 +1,42 @@
+import { useCallback, useLayoutEffect, useRef } from 'react';
+import { AppState } from 'react-native';
+import { useFocusEffect } from 'expo-router';
+import { createRefreshLoop, type RefreshContext } from '../utils/refresh-loop';
+
+export function useActiveRefresh(
+  identity: string,
+  task: (context: RefreshContext) => Promise<boolean | void>,
+  intervalMs: number,
+) {
+  const taskRef = useRef(task);
+  useLayoutEffect(() => { taskRef.current = task; }, [task]);
+  const loopRef = useRef<ReturnType<typeof createRefreshLoop> | null>(null);
+  const mutating = useRef(false);
+  useLayoutEffect(() => { loopRef.current?.stop(); }, [identity, intervalMs]);
+
+  useFocusEffect(useCallback(() => {
+    const loop = createRefreshLoop(context => taskRef.current(context), intervalMs);
+    loopRef.current = loop;
+    loop.setActive(AppState.currentState === 'active');
+    const subscription = AppState.addEventListener('change', state => loop.setActive(state === 'active'));
+    return () => {
+      loop.stop();
+      if (loopRef.current === loop) loopRef.current = null;
+      subscription.remove();
+    };
+  }, [identity, intervalMs]));
+
+  const refresh = useCallback(() => loopRef.current?.refresh(), []);
+  const mutate = useCallback(async <T,>(operation: () => Promise<T>): Promise<T> => {
+    if (mutating.current) throw new Error('Đang xử lý thao tác trước');
+    mutating.current = true;
+    const loop = loopRef.current;
+    loop?.pause();
+    try { return await operation(); }
+    finally {
+      mutating.current = false;
+      if (loopRef.current === loop) loop?.resume();
+    }
+  }, []);
+  return { refresh, mutate };
+}
diff --git a/mobile/utils/refresh-loop.ts b/mobile/utils/refresh-loop.ts
index e69de29..bbdbcee 100644
--- a/mobile/utils/refresh-loop.ts
+++ b/mobile/utils/refresh-loop.ts
@@ -0,0 +1,42 @@
+/** A small per-screen loop: one request batch, invalidation and coalesced refresh. */
+export type RefreshContext = { isCurrent: () => boolean; immediate: boolean };
+export function createRefreshLoop(
+  task: (context: RefreshContext) => Promise<boolean | void>,
+  intervalMs: number,
+  timers = { set: (fn: () => void, ms: number) => setTimeout(fn, ms), clear: (id: ReturnType<typeof setTimeout>) => clearTimeout(id) },
+) {
+  let active = false, paused = false, running = false, pending = false;
+  let generation = 0;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const cancelTimer = () => { if (timer !== undefined) timers.clear(timer); timer = undefined; };
+  const current = (version: number) => active && !paused && version === generation;
+  async function execute(immediate: boolean) {
+    if (!active || paused) return;
+    cancelTimer();
+    if (running) { pending = true; return; }
+    running = true;
+    pending = false;
+    const version = generation;
+    let poll = true;
+    try { poll = (await task({ isCurrent: () => current(version), immediate })) !== false; }
+    catch { /* The next tick retries; screens own their error state. */ }
+    finally {
+      running = false;
+      if (active && !paused) {
+        if (pending) { pending = false; void execute(true); }
+        else if (poll) timer = timers.set(() => { void execute(false); }, intervalMs);
+      }
+    }
+  }
+  return {
+    setActive(value: boolean) {
+      if (active === value) return;
+      active = value; generation++; cancelTimer();
+      if (active) void execute(true);
+    },
+    refresh() { generation++; void execute(true); },
+    pause() { paused = true; generation++; cancelTimer(); },
+    resume() { paused = false; generation++; void execute(true); },
+    stop() { active = false; generation++; pending = false; cancelTimer(); },
+  };
+}
diff --git a/mobile/utils/trip-map-data.ts b/mobile/utils/trip-map-data.ts
index e69de29..f4f4893 100644
--- a/mobile/utils/trip-map-data.ts
+++ b/mobile/utils/trip-map-data.ts
@@ -0,0 +1,20 @@
+type MapTrip = {
+  polylineGeometry?: string | null;
+  stops: readonly {
+    stopOrder: number; latitude: number; longitude: number; stopType: string;
+    studentName?: string | null; addressText?: string | null;
+    plannedArrivalTime?: string | null; isMyChild?: boolean;
+  }[];
+};
+
+/** Dynamic attendance, status and assignment must never change the map source. */
+export function getTripMapSnapshot(trip: MapTrip | null): string {
+  return JSON.stringify(trip ? {
+    polylineGeometry: trip.polylineGeometry,
+    stops: trip.stops.map(stop => ({
+      order: stop.stopOrder, lat: stop.latitude, lng: stop.longitude, type: stop.stopType,
+      name: stop.studentName || stop.addressText, address: stop.addressText,
+      eta: stop.plannedArrivalTime || '', isMyChild: stop.isMyChild ?? false,
+    })),
+  } : null);
+}
diff --git a/mobile/scripts/trip-state-synchronization.test.ts b/mobile/scripts/trip-state-synchronization.test.ts
index e69de29..ced390f 100644
--- a/mobile/scripts/trip-state-synchronization.test.ts
+++ b/mobile/scripts/trip-state-synchronization.test.ts
@@ -0,0 +1,96 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRefreshLoop } from '../utils/refresh-loop.ts';
+import { getTripMapSnapshot } from '../utils/trip-map-data.ts';
+
+const flush = async () => { for (let i = 0; i < 8; i++) await Promise.resolve(); };
+function clock() {
+  const queue: { fn: () => void; cancelled: boolean; ms: number }[] = [];
+  return {
+    queue,
+    timers: {
+      set(fn: () => void, ms: number) { const item = { fn, cancelled: false, ms }; queue.push(item); return item as unknown as ReturnType<typeof setTimeout>; },
+      clear(id: ReturnType<typeof setTimeout>) { (id as unknown as { cancelled: boolean }).cancelled = true; },
+    },
+    tick() { const item = queue.find(item => !item.cancelled); if (!item) throw Error('No scheduled request'); item.cancelled = true; item.fn(); },
+    count() { return queue.filter(item => !item.cancelled).length; },
+  };
+}
+
+describe('Active screen refresh coordinator', () => {
+  it('keeps the map source unchanged for operation and assignment updates', () => {
+    const trip = { polylineGeometry: 'geometry', status: 'SCHEDULED', driverId: 'first', stops: [
+      { stopOrder: 1, latitude: 10, longitude: 106, stopType: 'PICKUP', attendanceStatus: 'UNMARKED' },
+    ] };
+    const initial = getTripMapSnapshot(trip);
+    trip.status = 'IN_PROGRESS'; trip.driverId = 'replacement'; trip.stops[0].attendanceStatus = 'PRESENT';
+    assert.equal(getTripMapSnapshot(trip), initial);
+    trip.stops[0].latitude = 11;
+    assert.notEqual(getTripMapSnapshot(trip), initial);
+  });
+  it('fetches immediately, polls at cadence and stops in background/unmount', async () => {
+    const time = clock(); let calls = 0;
+    const loop = createRefreshLoop(async () => { calls++; }, 5000, time.timers);
+    loop.setActive(true); await flush();
+    assert.equal(calls, 1); assert.equal(time.count(), 1);
+    assert.equal(time.queue[0].ms, 5000);
+    time.tick(); await flush(); assert.equal(calls, 2);
+    loop.setActive(false); assert.equal(time.count(), 0);
+    loop.setActive(true); await flush(); assert.equal(calls, 3);
+    loop.stop(); assert.equal(time.count(), 0);
+  });
+
+  it('coalesces overlapping refreshes and prevents an old response overwriting new state', async () => {
+    const time = clock(); let finish!: () => void; let calls = 0; const applied: number[] = [];
+    const loop = createRefreshLoop(async context => {
+      const call = ++calls;
+      if (call === 1) await new Promise<void>(resolve => { finish = resolve; });
+      if (context.isCurrent()) applied.push(call);
+    }, 5000, time.timers);
+    loop.setActive(true);
+    loop.refresh(); loop.refresh();
+    assert.equal(calls, 1);
+    finish(); await flush();
+    assert.deepEqual(applied, [2]); assert.equal(time.count(), 1);
+    loop.stop();
+  });
+
+  it('invalidates reads around a mutation and immediately refetches when resumed', async () => {
+    const time = clock(); let finish!: () => void; let calls = 0; const applied: number[] = [];
+    const loop = createRefreshLoop(async context => {
+      const call = ++calls;
+      if (call === 1) await new Promise<void>(resolve => { finish = resolve; });
+      if (context.isCurrent()) applied.push(call);
+    }, 5000, time.timers);
+    loop.setActive(true); loop.pause();
+    finish(); await flush(); assert.deepEqual(applied, []); assert.equal(time.count(), 0);
+    loop.resume(); await flush(); assert.deepEqual(applied, [2]);
+    loop.stop();
+  });
+
+  it('ignores late results after scope disposal and never schedules another request', async () => {
+    const time = clock(); let finish!: () => void; let applied = false;
+    const loop = createRefreshLoop(async context => {
+      await new Promise<void>(resolve => { finish = resolve; });
+      if (context.isCurrent()) applied = true;
+    }, 5000, time.timers);
+    loop.setActive(true); loop.stop(); finish(); await flush();
+    assert.equal(applied, false); assert.equal(time.count(), 0);
+  });
+
+  it('retries temporary failures but does not keep polling terminal or revoked data', async () => {
+    const time = clock(); let calls = 0;
+    const loop = createRefreshLoop(async () => { if (++calls === 1) throw Error('offline'); return false; }, 8000, time.timers);
+    loop.setActive(true); await flush(); assert.equal(time.count(), 1);
+    time.tick(); await flush(); assert.equal(calls, 2); assert.equal(time.count(), 0);
+    loop.refresh(); await flush(); assert.equal(calls, 3); assert.equal(time.count(), 0);
+    loop.stop();
+  });
+
+  it('keeps polling an empty list, preventing empty Home from hiding a new assignment', async () => {
+    const time = clock(); let count = 0;
+    const loop = createRefreshLoop(async () => { count++; }, 12000, time.timers);
+    loop.setActive(true); await flush(); time.tick(); await flush();
+    assert.equal(count, 2); assert.equal(time.count(), 1); loop.stop();
+  });
+});
diff --git a/web/src/hooks/use-visible-refresh.ts b/web/src/hooks/use-visible-refresh.ts
index e69de29..c76e70d 100644
--- a/web/src/hooks/use-visible-refresh.ts
+++ b/web/src/hooks/use-visible-refresh.ts
@@ -0,0 +1,33 @@
+'use client';
+
+import { useCallback, useEffect, useLayoutEffect, useRef } from 'react';
+import { createRefreshLoop, type RefreshContext } from '../lib/refresh-loop';
+
+export function useVisibleRefresh(
+  identity: string,
+  task: (context: RefreshContext) => Promise<boolean | void>,
+  intervalMs = 15000,
+) {
+  const taskRef = useRef(task);
+  useLayoutEffect(() => { taskRef.current = task; }, [task]);
+  const loopRef = useRef<ReturnType<typeof createRefreshLoop> | null>(null);
+  useLayoutEffect(() => { loopRef.current?.stop(); }, [identity, intervalMs]);
+  useEffect(() => {
+    const loop = createRefreshLoop(context => taskRef.current(context), intervalMs);
+    loopRef.current = loop;
+    const visibility = () => loop.setActive(document.visibilityState === 'visible');
+    const refresh = () => { if (document.visibilityState === 'visible') loop.refresh(); };
+    visibility();
+    document.addEventListener('visibilitychange', visibility);
+    window.addEventListener('focus', refresh);
+    window.addEventListener('online', refresh);
+    return () => {
+      loop.stop();
+      if (loopRef.current === loop) loopRef.current = null;
+      document.removeEventListener('visibilitychange', visibility);
+      window.removeEventListener('focus', refresh);
+      window.removeEventListener('online', refresh);
+    };
+  }, [identity, intervalMs]);
+  return useCallback(() => loopRef.current?.refresh(), []);
+}

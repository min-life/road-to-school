@@ -0,0 +1,28 @@
+import * as SecureStore from 'expo-secure-store';
+import { Platform } from 'react-native';
+
+// This device preference is separate from authentication and survives logout.
+const ONBOARDING_KEY = 'r2s_onboarding_v1_completed';
+
+export const onboardingStorage = {
+  async isCompleted(): Promise<boolean> {
+    try {
+      const value = Platform.OS === 'web'
+        ? (typeof window !== 'undefined' ? window.localStorage.getItem(ONBOARDING_KEY) : null)
+        : await SecureStore.getItemAsync(ONBOARDING_KEY);
+      return value === 'true';
+    } catch {
+      // An unavailable preference must never be mistaken for an auth failure.
+      return false;
+    }
+  },
+
+  async complete(): Promise<void> {
+    if (Platform.OS === 'web') {
+      if (typeof window === 'undefined') throw new Error('Storage unavailable');
+      window.localStorage.setItem(ONBOARDING_KEY, 'true');
+    } else {
+      await SecureStore.setItemAsync(ONBOARDING_KEY, 'true');
+    }
+  },
+};
diff --git a/mobile/utils/onboarding-route.ts b/mobile/utils/onboarding-route.ts
new file mode 100644
index 0000000..e1b06cb
--- /dev/null
+++ b/mobile/utils/onboarding-route.ts
@@ -0,0 +1,19 @@
+interface OnboardingRouteState {
+  ready: boolean;
+  completed: boolean;
+  authenticated: boolean;
+  inAuthGroup: boolean;
+  authScreen?: string;
+}
+
+/** Only intercept the unauthenticated entry point, never an OTP/deep-link flow. */
+export function getOnboardingDestination(state: OnboardingRouteState): 'onboarding' | 'login' | null {
+  if (!state.ready || state.authenticated) return null;
+  if (state.authScreen === 'onboarding' && state.inAuthGroup) {
+    return state.completed ? 'login' : null;
+  }
+  if (!state.completed && (!state.inAuthGroup || state.authScreen === 'login')) {
+    return 'onboarding';
+  }
+  return null;
+}

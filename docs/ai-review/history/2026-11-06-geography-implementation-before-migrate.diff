+import { Prisma } from '@prisma/client';
+import { serviceDay } from './school-policy.js';
+import { contractDate } from './school-effective-state.js';
+import { formatDateToVnYmd } from '../trips/utils/trip-time.util.js';
+import { pendingParkingChange } from '../system-settings/parking-policy.js';
+
+export async function firstServiceDate(
+  db: Prisma.TransactionClient,
+  plan: {
+    schoolId: string;
+    status: string;
+    createdAt: Date;
+    activatedAt: Date | null;
+    needsReoptimization: boolean;
+  },
+): Promise<string | null> {
+  if (plan.status !== 'ACTIVE' || !plan.activatedAt || plan.needsReoptimization)
+    return null;
+  const school = await db.school.findUnique({ where: { id: plan.schoolId } });
+  if (!school) return null;
+  const start = new Date(formatDateToVnYmd(plan.activatedAt));
+  start.setUTCDate(start.getUTCDate() + 1);
+  for (
+    let date = start;
+    date <= school.contractEndDate;
+    date.setUTCDate(date.getUTCDate() + 1)
+  ) {
+    const day = contractDate(date);
+    if (
+      !(await pendingParkingChange(db, day)) &&
+      (await serviceDay(db, plan.schoolId, day, plan.createdAt))
+    )
+      return day;
+  }
+  return null;
+}
diff --git a/api/src/schools/geography.ts b/api/src/schools/geography.ts
new file mode 100644
index 0000000..68fdbd0
--- /dev/null
+++ b/api/src/schools/geography.ts
@@ -0,0 +1,97 @@
+import { Prisma } from '@prisma/client';
+import { vietnamToday } from './school-effective-state.js';
+import { GeographyQueryDto } from './dto/geography.dto.js';
+
+type LocationInput = {
+  province?: unknown;
+  provinceId?: unknown;
+  wardId?: unknown;
+  ward?: unknown;
+};
+const text = (value: unknown): string | null =>
+  typeof value === 'string' && value.trim() ? value.trim() : null;
+
+export function geographyFields(value: LocationInput) {
+  return {
+    province: text(value.province),
+    provinceId: text(value.provinceId),
+    wardId: text(value.wardId),
+    ward: text(value.ward),
+  };
+}
+
+export function matchesGeography(
+  value: LocationInput,
+  query: GeographyQueryDto,
+) {
+  return (
+    (!query.provinceId || value.provinceId === query.provinceId) &&
+    (!query.wardId || value.wardId === query.wardId)
+  );
+}
+
+/** Read effective locations, including changes already due while catch-up is delayed. */
+export async function effectiveSchoolLocations(db: Prisma.TransactionClient) {
+  const schools = await db.school.findMany({
+    select: {
+      id: true,
+      province: true,
+      provinceId: true,
+      wardId: true,
+      ward: true,
+      scheduledChanges: {
+        where: {
+          type: 'LOCATION',
+          status: 'PENDING',
+          effectiveDate: { lte: new Date(vietnamToday()) },
+        },
+        orderBy: [{ effectiveDate: 'asc' }, { createdAt: 'asc' }],
+        select: { payload: true },
+      },
+    },
+  });
+  return schools.map((school) => {
+    const last = school.scheduledChanges.at(-1);
+    return {
+      id: school.id,
+      ...geographyFields(last ? (last.payload as Prisma.JsonObject) : school),
+    };
+  });
+}
+
+/** Build options only from records inside the caller's authorized scope. */
+export function locationOptions(rows: LocationInput[], provinceId?: string) {
+  const provinces = new Map<string, { id: string; name: string }>();
+  const wards = new Map<
+    string,
+    { id: string; name: string; provinceId: string }
+  >();
+  for (const row of rows) {
+    const value = geographyFields(row);
+    if (value.provinceId && value.province)
+      provinces.set(value.provinceId, {
+        id: value.provinceId,
+        name: value.province,
+      });
+    if (
+      value.wardId &&
+      value.ward &&
+      value.provinceId &&
+      (!provinceId || provinceId === value.provinceId)
+    ) {
+      wards.set(value.provinceId + ':' + value.wardId, {
+        id: value.wardId,
+        name: value.ward,
+        provinceId: value.provinceId,
+      });
+    }
+  }
+  const byName = (
+    a: { name: string; id: string },
+    b: { name: string; id: string },
+  ) => a.name.localeCompare(b.name, 'vi') || a.id.localeCompare(b.id);
+  return {
+    provinces: [...provinces.values()].sort(byName),
+    wards: [...wards.values()].sort(byName),
+  };
+}
diff --git a/api/src/schools/location-province.ts b/api/src/schools/location-province.ts
new file mode 100644
index 0000000..d0f55b4
--- /dev/null
+++ b/api/src/schools/location-province.ts
@@ -0,0 +1,86 @@
+/** VIETMAP Reverse v4 returns the province/city in boundaries[type=0]. */
+export async function locationForCoordinates(
+  latitude: number | null | undefined,
+  longitude: number | null | undefined,
+): Promise<{
+  province: string | null;
+  provinceId: string | null;
+  wardId: string | null;
+  ward: string | null;
+  addressText: string | null;
+}> {
+  const unknown = {
+    province: null,
+    provinceId: null,
+    wardId: null,
+    ward: null,
+    addressText: null,
+  };
+  const key = process.env.VIETMAP_SERVICES_KEY;
+  if (
+    !key ||
+    latitude == null ||
+    longitude == null ||
+    !Number.isFinite(latitude) ||
+    !Number.isFinite(longitude)
+  )
+    return unknown;
+  const url = new URL('https://maps.vietmap.vn/api/reverse/v4');
+  url.searchParams.set('apikey', key);
+  url.searchParams.set('lat', String(latitude));
+  url.searchParams.set('lng', String(longitude));
+  url.searchParams.set('display_type', '5');
+  try {
+    const response = await fetch(url, { signal: AbortSignal.timeout(3000) });
+    if (!response.ok) return unknown;
+    const data: unknown = await response.json();
+    const first = Array.isArray(data) ? data[0] : null;
+    const boundary = Array.isArray(first?.boundaries)
+      ? first.boundaries.find((item: { type?: number }) => item.type === 0)
+      : null;
+    const province =
+      boundary?.full_name ?? boundary?.name ?? first?.province ?? first?.city;
+    const wardBoundary = Array.isArray(first?.boundaries)
+      ? first.boundaries.find((item: { type?: number }) => item.type === 2)
+      : null;
+    const identifier = (value: unknown): string | null =>
+      (typeof value === 'number' && Number.isFinite(value)) ||
+      (typeof value === 'string' && value.trim())
+        ? String(value).trim()
+        : null;
+    const ward = wardBoundary?.full_name ?? wardBoundary?.name;
+    const address = first?.display ?? first?.address;
+    return {
+      provinceId: identifier(boundary?.id),
+      wardId: identifier(wardBoundary?.id),
+      ward: typeof ward === 'string' && ward.trim() ? ward.trim() : null,
+      province:
+        typeof province === 'string' && province.trim()
+          ? province.trim().slice(0, 100)
+          : null,
+      addressText:
+        typeof address === 'string' && address.trim() ? address.trim() : null,
+    };
+  } catch {
+    return unknown;
+  }
+}
+
+/** Persist only administrative metadata; never replace the user's address text. */
+export async function administrativeLocationForCoordinates(
+  latitude: number | null | undefined,
+  longitude: number | null | undefined,
+) {
+  const { province, provinceId, wardId, ward } = await locationForCoordinates(
+    latitude,
+    longitude,
+  );
+  return { province, provinceId, wardId, ward };
+}
+
+export async function provinceForCoordinates(
+  latitude: number | null | undefined,
+  longitude: number | null | undefined,
+): Promise<string | null> {
+  return (await locationForCoordinates(latitude, longitude)).province;
+}

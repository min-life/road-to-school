diff --git a/docs/implementation/sql/bootstrap-parent-ui.sql b/docs/implementation/sql/bootstrap-parent-ui.sql
new file mode 100644
index 0000000..77a06ff
--- /dev/null
+++ b/docs/implementation/sql/bootstrap-parent-ui.sql
@@ -0,0 +1,457 @@
+-- ROADTOSCHOOL V2 / LOCAL DATABASE roadtoschool (ket noi pgAdmin nhu .env, port5433).
+-- FILE DAY DU: KHONG CAN TIM/DIEN BAT KY ID NAO.
+-- Trong Query Tool: ROLLBACK; neu transaction cu bi loi, roi dan TOAN BO file nay.
+-- Thay <DAT_MAT_KHAU_TEST> bang mat khau tai khoan TEST MOI do ban chon.
+-- Giu nguyen mat khau/ho so PARENT cu; neu nhieu PARENT, dien email/phone trong config.
+-- Du lieu [UI TEST], coordinates/ETA mo phong. KHONG dung cho van hanh that.
+-- Tao pgcrypto neu thieu (can quyen CREATE extension), KHONG can cai npm package.
+-- Agent CHI SOAN FILE: KHONG ket noi database, KHONG chay SQL/seed.
+
+BEGIN ISOLATION LEVEL SERIALIZABLE;
+SET LOCAL TIME ZONE 'UTC';
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '30s';
+DO $rts_database$
+BEGIN
+  IF current_database() <> 'roadtoschool' THEN
+    RAISE EXCEPTION 'Chon database roadtoschool local truoc khi chay.';
+  END IF;
+END;
+$rts_database$;
+CREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA public;
+CREATE TEMP TABLE rts_ui_bootstrap_config (
+  tag text NOT NULL, parent_id text NOT NULL, creator_id text NOT NULL,
+  school_id text NOT NULL, vehicle_id text NOT NULL, driver_id text NOT NULL,
+  attendant_id text NOT NULL, student_ids text[] NOT NULL
+) ON COMMIT DROP;
+
+DO $rts_bootstrap$
+DECLARE
+  -- CHI CAN SUA MAT KHAU TAI KHOAN TEST MOI trong ban copy o Query Tool.
+  -- Khong sua file trong Git thanh mat khau that.
+  v_test_password text := '<DAT_MAT_KHAU_TEST>';
+  -- NULL: dung PARENT active/verified duy nhat; neu khong co thi tao PARENT test.
+  -- Neu co nhieu PARENT, dien email/so dien thoai tai khoan mobile can test.
+  v_parent_identifier text := NULL;
+  -- NULL: lay phone cua PARENT. Chi dien neu parent chua co phone/tao parent moi.
+  v_guardian_phone text := NULL;
+  v_tag text := 'ui-bootstrap-01';
+  v_plate text := '99Z-999.91'; -- bien so minh hoa, KHONG phai xe van hanh.
+
+  v_parent_id text;
+  v_parent_phone text;
+  v_parent_count integer;
+  v_school_id text := gen_random_uuid()::text;
+  v_vehicle_id text := gen_random_uuid()::text;
+  v_student_ids text[] := ARRAY[]::text[];
+  v_staff jsonb := '{}'::jsonb;
+  v_role text;
+  v_user_id text;
+  v_email text;
+  v_school_name text;
+  v_parking jsonb;
+  v_base_lat double precision;
+  v_base_lng double precision;
+  v_today date := (CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Ho_Chi_Minh')::date;
+  v_i integer;
+  v_student_id text;
+  v_code text;
+BEGIN
+  IF current_database() <> 'roadtoschool' THEN
+    RAISE EXCEPTION 'Can chon database roadtoschool local, hien tai la %.', current_database();
+  END IF;
+  IF left(v_test_password, 1) = '<' OR coalesce(length(v_test_password), 0) < 8
+     OR octet_length(v_test_password) > 72 THEN
+    RAISE EXCEPTION 'Dien v_test_password: it nhat 8 ky tu, toi da 72 byte. Mat khau parent cu KHONG doi.';
+  END IF;
+  IF v_tag !~ '^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$' THEN
+    RAISE EXCEPTION 'Tag dung a-z, 0-9 va -, dau/cuoi la chu hoac so, toi da 40 ky tu.';
+  END IF;
+  PERFORM pg_advisory_xact_lock(hashtextextended('UI-TEST-ROUTE-' || v_tag, 0));
+  v_school_name := '[UI TEST ' || v_tag || '] Truong minh hoa';
+  IF EXISTS (SELECT 1 FROM public.route_plans WHERE name = 'UI-TEST-ROUTE-' || v_tag)
+     OR EXISTS (SELECT 1 FROM public.schools WHERE name = v_school_name) THEN
+    RAISE EXCEPTION 'Bo UI test % da ton tai. Script khong ghi de/tao lap.', v_tag;
+  END IF;
+  IF EXISTS (SELECT 1 FROM public.vehicles
+             WHERE normalized_plate = regexp_replace(upper(v_plate), '[^A-Z0-9]', '', 'g')) THEN
+    RAISE EXCEPTION 'Bien so minh hoa % da ton tai; script khong sua xe cu.', v_plate;
+  END IF;
+  IF (SELECT n.nspname FROM pg_extension e JOIN pg_namespace n ON n.oid = e.extnamespace
+      WHERE e.extname = 'pgcrypto') IS DISTINCT FROM 'public' THEN
+    RAISE EXCEPTION 'pgcrypto can nam trong schema public; khong tu di chuyen extension cu.';
+  END IF;
+
+  IF coalesce(btrim(v_parent_identifier), '') <> '' THEN
+    SELECT count(*) INTO v_parent_count FROM public.users
+    WHERE role = 'PARENT' AND is_active AND is_verified
+      AND (lower(email) = lower(btrim(v_parent_identifier)) OR phone = btrim(v_parent_identifier));
+    IF v_parent_count <> 1 THEN
+      RAISE EXCEPTION 'Khong tim thay dung 1 PARENT active/verified theo email/phone da dien.';
+    END IF;
+    SELECT id, phone INTO v_parent_id, v_parent_phone FROM public.users
+    WHERE role = 'PARENT' AND is_active AND is_verified
+      AND (lower(email) = lower(btrim(v_parent_identifier)) OR phone = btrim(v_parent_identifier));
+  ELSE
+    SELECT count(*) INTO v_parent_count FROM public.users
+    WHERE role = 'PARENT' AND is_active AND is_verified;
+    IF v_parent_count > 1 THEN
+      RAISE EXCEPTION 'Co nhieu PARENT. Dien v_parent_identifier bang email/phone, khong can ID.';
+    END IF;
+    IF v_parent_count = 1 THEN
+      SELECT id, phone INTO v_parent_id, v_parent_phone FROM public.users
+      WHERE role = 'PARENT' AND is_active AND is_verified;
+    END IF;
+  END IF;
+  v_guardian_phone := coalesce(nullif(btrim(v_guardian_phone), ''), v_parent_phone);
+  IF coalesce(v_guardian_phone, '') !~ '^(0|\+84)[0-9]{9,10}$' THEN
+    RAISE EXCEPTION 'Parent chua co phone hop le: dien v_guardian_phone bang so cua ban de tao hoc sinh, khong can ID.';
+  END IF;
+  IF v_parent_id IS NULL THEN
+    v_parent_id := gen_random_uuid()::text;
+    v_email := 'ui-parent@' || v_tag || '.example.invalid';
+    IF EXISTS (SELECT 1 FROM public.users WHERE email = v_email OR phone = v_guardian_phone) THEN
+      RAISE EXCEPTION 'Email/phone cho parent test da ton tai. Khong ghi de tai khoan cu.';
+    END IF;
+    INSERT INTO public.users
+      (id, email, phone, full_name, password_hash, role, is_verified, is_active, created_at, updated_at)
+    VALUES (v_parent_id, v_email, v_guardian_phone, '[UI TEST] Phu huynh',
+      public.crypt(v_test_password, public.gen_salt('bf', 10)), 'PARENT', true, true,
+      CURRENT_TIMESTAMP, CURRENT_TIMESTAMP);
+    RAISE NOTICE 'Da tao PARENT test: %. Mat khau la v_test_password ban vua chon.', v_email;
+  ELSE
+    RAISE NOTICE 'Dung PARENT da co, id=%. Giu nguyen email/phone/mat khau/ho so.', v_parent_id;
+  END IF;
+
+  -- Giu nguyen PARKING_LOT hien co. Neu chi co key cu parking_lot, sao chep cung gia tri.
+  SELECT value INTO v_parking FROM public.system_settings WHERE key = 'PARKING_LOT';
+  IF v_parking IS NULL THEN
+    SELECT value INTO v_parking FROM public.system_settings WHERE key = 'parking_lot';
+  END IF;
+  IF v_parking IS NULL THEN
+    v_parking := jsonb_build_object('addressText', '[UI TEST] Bai xe mo phong',
+                                  'latitude', 10.776889, 'longitude', 106.700806);
+  END IF;
+  v_base_lat := (v_parking->>'latitude')::double precision;
+  v_base_lng := (v_parking->>'longitude')::double precision;
+  IF v_base_lat IS NULL OR v_base_lng IS NULL OR v_base_lat = 0 OR v_base_lng = 0
+     OR v_base_lat NOT BETWEEN -89.9 AND 89.9 OR v_base_lng NOT BETWEEN -179.9 AND 179.9
+     OR coalesce(nullif(v_parking->>'addressText', ''), nullif(v_parking->>'address', '')) IS NULL THEN
+    RAISE EXCEPTION 'Cau hinh bai xe cu khong hop le. Script khong sua gia tri cu.';
+  END IF;
+
+  -- Demo coordinates quanh bai xe, KHONG phai dia chi truong/nha hoc sinh that.
+  INSERT INTO public.schools
+    (id, name, address_text, latitude, longitude, contract_start_date, contract_end_date,
+     weekly_schedule, is_active, created_at, updated_at)
+  VALUES (v_school_id, v_school_name, '[UI TEST] Diem truong mo phong', v_base_lat + 0.02, v_base_lng + 0.02,
+    v_today, v_today + 90,
+    (SELECT jsonb_object_agg(day_name, jsonb_build_object('start', '07:30', 'end', '16:30'))
+     FROM unnest(ARRAY['monday','tuesday','wednesday','thursday','friday']) AS days(day_name)),
+    true, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP);
+
+  -- Tai khoan test tach biet; khong sua tai khoan nhan su that.
+  FOREACH v_role IN ARRAY ARRAY['SYSTEM_ADMIN','SCHOOL_ADMIN','DRIVER','BUS_ATTENDANT'] LOOP
+    v_user_id := gen_random_uuid()::text;
+    v_email := 'ui-' || replace(lower(v_role), '_', '-') || '@' || v_tag || '.example.invalid';
+    IF EXISTS (SELECT 1 FROM public.users WHERE email = v_email) THEN
+      RAISE EXCEPTION 'Tai khoan test % da ton tai. Khong ghi de.', v_email;
+    END IF;
+    INSERT INTO public.users
+      (id, email, full_name, password_hash, role, school_id, is_verified, is_active, created_at, updated_at)
+    VALUES (v_user_id, v_email, '[UI TEST] ' || v_role,
+      public.crypt(v_test_password, public.gen_salt('bf', 10)), v_role::public."Role",
+      CASE WHEN v_role IN ('SCHOOL_ADMIN','BUS_ATTENDANT') THEN v_school_id ELSE NULL END,
+      true, true, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP);
+    v_staff := jsonb_set(v_staff, ARRAY[v_role], to_jsonb(v_user_id), true);
+    RAISE NOTICE 'Tai khoan test %: %. Mat khau la v_test_password ban vua chon.', v_role, v_email;
+  END LOOP;
+  INSERT INTO public.system_settings (id, key, value, updated_by_id, updated_at)
+  SELECT gen_random_uuid()::text, 'PARKING_LOT', v_parking, v_staff->>'SYSTEM_ADMIN', CURRENT_TIMESTAMP
+  WHERE NOT EXISTS (SELECT 1 FROM public.system_settings WHERE key = 'PARKING_LOT');
+
+  INSERT INTO public.vehicles
+    (id, brand, seat_count, license_plate, normalized_plate, color, created_at, updated_at)
+  VALUES (v_vehicle_id, 'UI TEST - Xe minh hoa', 16, v_plate,
+    regexp_replace(upper(v_plate), '[^A-Z0-9]', '', 'g'), 'Vang (UI TEST)', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP);
+
+  FOR v_i IN 1..2 LOOP
+    v_student_id := gen_random_uuid()::text;
+    -- STU + 8 ky tu [A-Z0-9], luon co ca chu va so, dung StudentCode regex.
+    v_code := 'STU' || upper(substr(md5(v_tag || ':' || v_i::text), 1, 6)) || 'A1';
+    IF EXISTS (SELECT 1 FROM public.students WHERE code = v_code) THEN
+      RAISE EXCEPTION 'Ma hoc sinh test % da ton tai. Khong ghi de.', v_code;
+    END IF;
+    INSERT INTO public.students
+      (id, code, school_id, full_name, guardian_phone, address_text, latitude, longitude,
+       status, created_at, updated_at)
+    VALUES (v_student_id, v_code, v_school_id, '[UI TEST] Hoc sinh ' || v_i::text,
+      v_guardian_phone, '[UI TEST] Diem don mo phong ' || v_i::text,
+      v_base_lat + 0.005 * v_i, v_base_lng + 0.007 * v_i,
+      'AVAILABLE', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP);
+    v_student_ids := array_append(v_student_ids, v_student_id);
+  END LOOP;
+
+  INSERT INTO pg_temp.rts_ui_bootstrap_config
+    (tag, parent_id, creator_id, school_id, vehicle_id, driver_id, attendant_id, student_ids)
+  VALUES (v_tag, v_parent_id, v_staff->>'SYSTEM_ADMIN', v_school_id, v_vehicle_id,
+          v_staff->>'DRIVER', v_staff->>'BUS_ATTENDANT', v_student_ids);
+END;
+$rts_bootstrap$;
+
+
+-- TU DONG NOI CAC ID VUA TAO VAO TUYEN/LINKS, KHONG SUA PHAN DUOI.
+DO $rts_ui$
+DECLARE
+  -- ========== ID TU DONG TU BOOTSTRAP: KHONG SUA ==========
+  v_expected_database text := 'roadtoschool';
+  v_parent_id text := (SELECT parent_id FROM pg_temp.rts_ui_bootstrap_config);
+  v_creator_id text := (SELECT creator_id FROM pg_temp.rts_ui_bootstrap_config);
+  v_school_id text := (SELECT school_id FROM pg_temp.rts_ui_bootstrap_config);
+  v_vehicle_id text := (SELECT vehicle_id FROM pg_temp.rts_ui_bootstrap_config);
+  -- Thu tu don tu bo hoc sinh test vua tao; chieu tra dao nguoc.
+  v_student_ids text[] := (SELECT student_ids FROM pg_temp.rts_ui_bootstrap_config);
+  v_tag text := (SELECT tag FROM pg_temp.rts_ui_bootstrap_config);
+  v_minutes integer := 45;     -- Thoi luong uoc luong moi chieu, chi test UI.
+  v_sample_date date := NULL;  -- NULL: tu chon ngay hoc gan nhat tu ngay mai.
+  -- ========== HET KHOI CAU HINH ==========
+
+  v_driver_id text := (SELECT driver_id FROM pg_temp.rts_ui_bootstrap_config);
+  v_attendant_id text := (SELECT attendant_id FROM pg_temp.rts_ui_bootstrap_config);
+  v_school public.schools%ROWTYPE;
+  v_parking jsonb;
+  v_day jsonb;
+  v_day_keys text[] := ARRAY['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];
+  v_today date := (CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Ho_Chi_Minh')::date;
+  v_capacity integer;
+  v_n integer;
+  v_distinct_n integer;
+  v_plan_id text := gen_random_uuid()::text;
+  v_plan_name text;
+  v_route_id text;
+  v_direction text;
+  v_outbound boolean;
+  v_start integer;
+  v_end integer;
+  v_school_start integer;
+  v_school_end integer;
+  v_duration integer;
+  v_constraints jsonb;
+  v_stops jsonb;
+  v_point jsonb;
+  v_geometry text;
+  v_distance double precision;
+  v_has_prev boolean;
+  v_lat bigint;
+  v_lng bigint;
+  v_prev_lat bigint;
+  v_prev_lng bigint;
+  v_delta bigint;
+  v_encoded bigint;
+  v_order integer;
+  v_eta integer;
+  v_new_links integer;
+BEGIN
+  IF current_database() <> v_expected_database THEN
+    RAISE EXCEPTION 'Database hien tai (%) khac cau hinh (%). Kiem tra database local.',
+      current_database(), v_expected_database;
+  END IF;
+  IF v_tag !~ '^[a-z0-9][a-z0-9_-]{0,39}$' THEN
+    RAISE EXCEPTION 'Tag chi dung a-z, 0-9, _ va -, toi da 40 ky tu.';
+  END IF;
+  v_plan_name := 'UI-TEST-ROUTE-' || v_tag;
+  PERFORM pg_advisory_xact_lock(hashtextextended(v_plan_name, 0));
+  IF EXISTS (SELECT 1 FROM public.route_plans WHERE name = v_plan_name) THEN
+    RAISE EXCEPTION 'Phuong an % da ton tai. Dung lai ban ghi cu; script khong ghi de.', v_plan_name;
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM public.users WHERE id = v_parent_id
+                 AND role = 'PARENT' AND is_active AND is_verified) THEN
+    RAISE EXCEPTION 'parent_id phai la PARENT dang hoat dong/da xac minh.';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM public.users WHERE id = v_creator_id
+                 AND role = 'SYSTEM_ADMIN' AND is_active AND is_verified) THEN
+    RAISE EXCEPTION 'creator_id phai la SYSTEM_ADMIN dang hoat dong/da xac minh.';
+  END IF;
+  SELECT * INTO v_school FROM public.schools WHERE id = v_school_id FOR SHARE;
+  IF NOT FOUND OR NOT v_school.is_active THEN
+    RAISE EXCEPTION 'Truong khong ton tai hoac khong hoat dong.';
+  END IF;
+  IF v_school.latitude IS NULL OR v_school.longitude IS NULL
+     OR v_school.latitude NOT BETWEEN -90 AND 90 OR v_school.longitude NOT BETWEEN -180 AND 180
+     OR coalesce(btrim(v_school.address_text), '') = '' THEN
+    RAISE EXCEPTION 'Truong phai co dia chi va toa do hop le.';
+  END IF;
+  v_n := cardinality(v_student_ids);
+  SELECT count(DISTINCT sid)::integer INTO v_distinct_n FROM unnest(v_student_ids) AS ids(sid);
+  IF coalesce(v_n, 0) = 0 OR v_n <> v_distinct_n OR array_position(v_student_ids, NULL) IS NOT NULL THEN
+    RAISE EXCEPTION 'Danh sach hoc sinh khong duoc rong, NULL hoac trung ID.';
+  END IF;
+  PERFORM s.id FROM public.students s WHERE s.id = ANY(v_student_ids) FOR UPDATE;
+  IF (SELECT count(*) FROM public.students s
+      WHERE s.id = ANY(v_student_ids) AND s.school_id = v_school_id AND s.status = 'AVAILABLE'
+        AND coalesce(btrim(s.address_text), '') <> ''
+        AND s.latitude BETWEEN -90 AND 90 AND s.longitude BETWEEN -180 AND 180) <> v_n THEN
+    RAISE EXCEPTION 'Hoc sinh phai ton tai, AVAILABLE, cung truong va co dia chi/toa do hop le.';
+  END IF;
+  IF EXISTS (SELECT 1 FROM public.route_stops rs
+             JOIN public.routes r ON r.id = rs.route_id
+             JOIN public.route_plans p ON p.id = r.route_plan_id
+             WHERE rs.student_id = ANY(v_student_ids) AND p.status IN ('DRAFT', 'ACTIVE')) THEN
+    RAISE EXCEPTION 'Co hoc sinh da duoc gan vao phuong an DRAFT/ACTIVE. Khong tu go phan cong cu.';
+  END IF;
+  SELECT seat_count INTO v_capacity FROM public.vehicles WHERE id = v_vehicle_id FOR UPDATE;
+  IF NOT FOUND OR v_capacity < v_n THEN
+    RAISE EXCEPTION 'Xe khong ton tai hoac khong du cho cho % hoc sinh.', v_n;
+  END IF;
+  IF EXISTS (SELECT 1 FROM public.routes r
+             JOIN public.route_plans p ON p.id = r.route_plan_id
+             JOIN public.schools sc ON sc.id = p.school_id
+             WHERE r.proposed_vehicle_id = v_vehicle_id AND p.status IN ('DRAFT', 'ACTIVE')
+               AND sc.contract_start_date <= v_school.contract_end_date
+               AND v_school.contract_start_date <= sc.contract_end_date) THEN
+    RAISE EXCEPTION 'Xe da duoc giu cho boi phuong an DRAFT/ACTIVE co hop dong chong lan.';
+  END IF;
+  SELECT value INTO v_parking FROM public.system_settings WHERE key = 'PARKING_LOT';
+  IF v_parking IS NULL OR coalesce(nullif(v_parking->>'addressText', ''), nullif(v_parking->>'address', ''), '') = ''
+     OR (v_parking->>'latitude') IS NULL OR (v_parking->>'longitude') IS NULL
+     OR NOT ((v_parking->>'latitude')::double precision BETWEEN -90 AND 90)
+     OR NOT ((v_parking->>'longitude')::double precision BETWEEN -180 AND 180)
+     OR (v_parking->>'latitude')::double precision = 0
+     OR (v_parking->>'longitude')::double precision = 0 THEN
+    RAISE EXCEPTION 'Can PARKING_LOT hop le; bootstrap khong ghi de gia tri cu.';
+  END IF;
+  IF v_sample_date IS NULL THEN
+    SELECT d::date INTO v_sample_date
+    FROM generate_series(greatest(v_today + 1, v_school.contract_start_date)::timestamp,
+                         least(v_school.contract_end_date,
+                               greatest(v_today + 1, v_school.contract_start_date) + 14)::timestamp,
+                         interval '1 day') AS dates(d)
+    WHERE coalesce(v_school.weekly_schedule -> (v_day_keys[extract(isodow FROM d)::integer]) ->> 'start', '') <> ''
+      AND coalesce(v_school.weekly_schedule -> (v_day_keys[extract(isodow FROM d)::integer]) ->> 'end', '') <> ''
+    ORDER BY d LIMIT 1;
+  END IF;
+  IF v_sample_date IS NULL OR v_sample_date <= v_today
+     OR v_sample_date NOT BETWEEN v_school.contract_start_date AND v_school.contract_end_date THEN
+    RAISE EXCEPTION 'Can ngay hoc tu ngay mai, nam trong hop dong. Kiem tra weekly_schedule/sample_date.';
+  END IF;
+  v_day := v_school.weekly_schedule -> (v_day_keys[extract(isodow FROM v_sample_date)::integer]);
+  IF coalesce(v_day->>'start', '') !~ '^([01][0-9]|2[0-3]):[0-5][0-9]$'
+     OR coalesce(v_day->>'end', '') !~ '^([01][0-9]|2[0-3]):[0-5][0-9]$' THEN
+    RAISE EXCEPTION 'Ngay chon khong co lich hoc start/end hop le HH:mm.';
+  END IF;
+  v_school_start := extract(epoch FROM (v_day->>'start')::time)::integer;
+  v_school_end := extract(epoch FROM (v_day->>'end')::time)::integer;
+  v_duration := v_minutes * 60;
+  IF v_minutes NOT BETWEEN 10 AND 180 OR v_school_end <= v_school_start
+     OR v_school_start < v_duration OR v_school_end + v_duration >= 86400
+     OR v_duration < v_n * 60 THEN
+    RAISE EXCEPTION 'Thoi luong/lich hoc khong hop le, vuot ngay hoac khong du thoi gian dung.';
+  END IF;
+  v_constraints := jsonb_build_object('maxRouteDurationMinutes', v_minutes,
+    'defaultStopServiceSeconds', 60, 'stopServiceOverrides', '[]'::jsonb,
+    'latestSchoolArrival', v_day->>'start', 'returnDepartureTime', v_day->>'end');
+
+  INSERT INTO public.route_plans
+    (id, school_id, name, status, schedule_scope, routing_constraints,
+     total_students, total_outbound_routes, total_return_routes, created_by_id, created_at, updated_at)
+  VALUES (v_plan_id, v_school_id, v_plan_name, 'DRAFT',
+    jsonb_build_object('createdAt', CURRENT_TIMESTAMP, 'constraints', v_constraints,
+      'summary', jsonb_build_object('assignedBothWaysCount', v_n, 'totalSelectedStudents', v_n,
+        'unassignedCount', 0, 'coverageRate', 1, 'unassignedStudents', '[]'::jsonb,
+        'excludedByAdminCount', 0, 'outboundVehiclesUsed', 1, 'returnVehiclesUsed', 1)),
+    v_constraints, v_n, 1, 1, v_creator_id, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP);
+
+  FOREACH v_direction IN ARRAY ARRAY['TO_SCHOOL', 'TO_PARKING'] LOOP
+    v_outbound := v_direction = 'TO_SCHOOL';
+    v_route_id := gen_random_uuid()::text;
+    v_start := CASE WHEN v_outbound THEN v_school_start - v_duration ELSE v_school_end END;
+    v_end := v_start + v_duration;
+    SELECT jsonb_agg(point ORDER BY idx) INTO v_stops FROM (
+      SELECT 0 AS idx, jsonb_build_object('studentId', NULL,
+        'stopType', CASE WHEN v_outbound THEN 'PARKING_START' ELSE 'SCHOOL_DEPARTURE' END,
+        'addressText', CASE WHEN v_outbound THEN coalesce(nullif(v_parking->>'addressText', ''), nullif(v_parking->>'address', '')) ELSE v_school.address_text END,
+        'latitude', CASE WHEN v_outbound THEN (v_parking->>'latitude')::double precision ELSE v_school.latitude END,
+        'longitude', CASE WHEN v_outbound THEN (v_parking->>'longitude')::double precision ELSE v_school.longitude END) AS point
+      UNION ALL
+      SELECT CASE WHEN v_outbound THEN supplied.ord::integer ELSE v_n + 1 - supplied.ord::integer END,
+        jsonb_build_object('studentId', s.id, 'stopType', CASE WHEN v_outbound THEN 'PICKUP' ELSE 'DROPOFF' END,
+          'addressText', s.address_text, 'latitude', s.latitude, 'longitude', s.longitude)
+      FROM unnest(v_student_ids) WITH ORDINALITY AS supplied(id, ord)
+      JOIN public.students s ON s.id = supplied.id
+      UNION ALL
+      SELECT v_n + 1, jsonb_build_object('studentId', NULL,
+        'stopType', CASE WHEN v_outbound THEN 'SCHOOL_ARRIVAL' ELSE 'PARKING_END' END,
+        'addressText', CASE WHEN v_outbound THEN v_school.address_text ELSE coalesce(nullif(v_parking->>'addressText', ''), nullif(v_parking->>'address', '')) END,
+        'latitude', CASE WHEN v_outbound THEN v_school.latitude ELSE (v_parking->>'latitude')::double precision END,
+        'longitude', CASE WHEN v_outbound THEN v_school.longitude ELSE (v_parking->>'longitude')::double precision END)
+    ) AS points;
+
+    -- Google/VietMap encoded polyline precision5, thu tu [latitude, longitude].
+    v_geometry := ''; v_distance := 0; v_has_prev := false;
+    v_prev_lat := 0; v_prev_lng := 0;
+    FOR v_point IN SELECT value FROM jsonb_array_elements(v_stops) LOOP
+      v_lat := round((v_point->>'latitude')::numeric * 100000)::bigint;
+      v_lng := round((v_point->>'longitude')::numeric * 100000)::bigint;
+      IF v_has_prev THEN
+        v_distance := v_distance + 12742000 * asin(sqrt(least(1.0, greatest(0.0,
+          power(sin(radians((v_lat - v_prev_lat) / 100000.0) / 2), 2) +
+          cos(radians(v_prev_lat / 100000.0)) * cos(radians(v_lat / 100000.0)) *
+          power(sin(radians((v_lng - v_prev_lng) / 100000.0) / 2), 2)))));
+      END IF;
+      FOREACH v_delta IN ARRAY ARRAY[v_lat - v_prev_lat, v_lng - v_prev_lng] LOOP
+        v_encoded := CASE WHEN v_delta < 0 THEN ~(v_delta << 1) ELSE v_delta << 1 END;
+        WHILE v_encoded >= 32 LOOP
+          v_geometry := v_geometry || chr((((v_encoded & 31) | 32) + 63)::integer);
+          v_encoded := v_encoded >> 5;
+        END LOOP;
+        v_geometry := v_geometry || chr((v_encoded + 63)::integer);
+      END LOOP;
+      v_prev_lat := v_lat; v_prev_lng := v_lng; v_has_prev := true;
+    END LOOP;
+
+    INSERT INTO public.routes
+      (id, route_plan_id, school_id, name, direction, proposed_vehicle_id, default_driver_id, default_bus_attendant_id,
+       total_distance_meters, estimated_duration_seconds, departure_time, arrival_time,
+       polyline_geometry, routing_constraints, created_at, updated_at)
+    VALUES (v_route_id, v_plan_id, v_school_id,
+      v_plan_name || CASE WHEN v_outbound THEN ' - Don' ELSE ' - Tra' END,
+      v_direction::public."RouteDirection", v_vehicle_id, v_driver_id, v_attendant_id, round(v_distance)::integer, v_duration,
+      to_char(make_interval(secs => v_start), 'HH24:MI'), to_char(make_interval(secs => v_end), 'HH24:MI'),
+      v_geometry, v_constraints, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP);
+
+    v_order := 0;
+    FOR v_point IN SELECT value FROM jsonb_array_elements(v_stops) LOOP
+      v_eta := v_start + (v_duration * v_order / (v_n + 1));
+      INSERT INTO public.route_stops
+        (id, route_id, stop_order, stop_type, student_id, address_text, latitude, longitude,
+         planned_arrival_seconds, planned_arrival_time, created_at)
+      VALUES (gen_random_uuid()::text, v_route_id, v_order,
+        (v_point->>'stopType')::public."RouteStopType", v_point->>'studentId',
+        v_point->>'addressText', (v_point->>'latitude')::double precision,
+        (v_point->>'longitude')::double precision, v_eta,
+        to_char(make_interval(secs => v_eta), 'HH24:MI'), CURRENT_TIMESTAMP);
+      v_order := v_order + 1;
+    END LOOP;
+  END LOOP;
+
+  INSERT INTO public.parent_student_links (id, parent_id, student_id, linked_at)
+  SELECT gen_random_uuid()::text, v_parent_id, sid, CURRENT_TIMESTAMP
+  FROM unnest(v_student_ids) AS selected(sid)
+  ON CONFLICT (parent_id, student_id) DO NOTHING;
+  GET DIAGNOSTICS v_new_links = ROW_COUNT;
+
+  RAISE NOTICE 'Plan: % / %. Routes: 2; students: %; stops: %; new parent links: %.',
+    v_plan_id, v_plan_name, v_n, 2 * (v_n + 2), v_new_links;
+  RAISE NOTICE 'DRAFT, KHONG co Trip. Ngay hoc tham khao: %. Da gan staff test. SCHOOL_ADMIN duyet tren Web, roi SYSTEM_ADMIN sinh chuyen.', v_sample_date;
+END;
+$rts_ui$;
+
+-- Tai khoan test moi: dung mat khau ban da dien, parent cu KHONG doi mat khau.
+-- Ket qua nay khong hien hash/password/session/token.
+SELECT u.role, u.email AS test_login, cfg.parent_id, cfg.school_id,
+       cfg.vehicle_id, cfg.student_ids, p.id AS route_plan_id, p.status AS route_plan_status
+FROM pg_temp.rts_ui_bootstrap_config cfg
+JOIN public.route_plans p ON p.name = 'UI-TEST-ROUTE-' || cfg.tag
+JOIN public.users u ON u.email LIKE 'ui-%@' || cfg.tag || '.example.invalid'
+ORDER BY u.role;
+COMMIT;

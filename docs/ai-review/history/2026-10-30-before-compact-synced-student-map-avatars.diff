+import { useCallback, useState } from 'react';
+import { useFocusEffect } from 'expo-router';
+import { mobileApiClient, type ParentLinkedStudentItem } from '@/services/api-client';
+
+type MapChild = Pick<ParentLinkedStudentItem, 'id' | 'fullName' | 'avatarUrl'>;
+
+/** Read only the signed-in parent's linked children, once per screen focus. */
+export function useParentMapAvatars(identity: string, enabled: boolean): readonly MapChild[] {
+  const [snapshot, setSnapshot] = useState<{ identity: string; children: MapChild[] } | null>(null);
+
+  useFocusEffect(useCallback(() => {
+    if (!enabled) return;
+    let current = true;
+    mobileApiClient.getLinkedStudents().then(children => {
+      if (current) setSnapshot({ identity, children: children.map(({ id, fullName, avatarUrl }) => ({ id, fullName, avatarUrl })) });
+    }).catch(() => {
+      if (current) setSnapshot({ identity, children: [] });
+    });
+    return () => { current = false; };
+  }, [identity, enabled]));
+
+  return enabled && snapshot?.identity === identity ? snapshot.children : [];
+}

+/** Match every search word across display fields, ignoring Vietnamese marks and case. */
+export function matchesSearchText(query: string, fields: readonly (string | null | undefined)[]): boolean {
+  const normalize = (value: string) => value.toLowerCase().normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd');
+  const words = normalize(query).trim().split(/\s+/).filter(Boolean);
+  const text = normalize(fields.filter(Boolean).join(' '));
+  return words.every(word => text.includes(word));
+}

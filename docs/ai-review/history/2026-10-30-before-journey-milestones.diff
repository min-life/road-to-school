+import { memo, useEffect, useMemo, useRef, useState } from 'react';
+import { Animated, Easing, StyleSheet, Text, View } from 'react-native';
+import Ionicons from '@expo/vector-icons/Ionicons';
+import { colors } from '@/constants/theme';
+import type { ParentHomeCardItem } from '@/services/api-client';
+import type { ParentJourneyTelemetry } from '@/hooks/use-parent-journey-telemetry';
+import { useReducedMotionPreference } from '@/hooks/use-reduced-motion-preference';
+import { observedJourneyProgress, studentJourneyMilestone, studentJourneyPath } from '@/utils/parent-journey';
+
+type Props = { card: ParentHomeCardItem; telemetry?: ParentJourneyTelemetry; active: boolean };
+
+/** A diagram of observed progress, not an ETA or a replacement for the tracking map. */
+export const ParentStudentJourney = memo(function ParentStudentJourney({ card, telemetry, active }: Props) {
+  const [expired, setExpired] = useState(false);
+  const last = useRef<{ version: string; progress: number; sequence: number } | null>(null);
+  const milestone = studentJourneyMilestone(card.tripStatus, card.direction, card.attendanceStatus, card.childIsAlighted);
+  const { detail, navigation, receivedAt } = telemetry ?? {};
+  const path = useMemo(() => detail && detail.id === card.tripId && detail.direction === card.direction
+    ? studentJourneyPath(detail, card.studentId) : null, [detail, card.tripId, card.studentId, card.direction]);
+  const version = navigation?.routeVersion;
+  const previous = last.current?.version === version ? last.current : null;
+  const sampleAge = navigation && receivedAt ? Date.parse(navigation.serverNow)
+    - Date.parse(navigation.latestPosition?.recordedAt ?? '') + Date.now() - receivedAt : Infinity;
+  const observed = path && navigation && !expired && sampleAge <= 15000 && !telemetry?.unavailable
+    && (!card.markedAt || card.attendanceStatus !== 'PRESENT'
+      || Date.parse(navigation.latestPosition?.recordedAt ?? '') >= Date.parse(card.markedAt))
+    ? observedJourneyProgress(path, navigation, card.attendanceStatus) : null;
+  const ordered = observed !== null && (navigation?.latestPosition?.sequence ?? -1) >= (previous?.sequence ?? -1);
+  const progress = milestone.progress ?? (milestone.inactive ? null : ordered ? observed : previous?.progress ?? null);
+  const live = milestone.progress === null && !milestone.inactive && ordered && observed !== null;
+  const outbound = card.direction === 'TO_SCHOOL';
+  const label = outbound && card.tripStatus === 'IN_PROGRESS' && card.attendanceStatus === 'UNMARKED'
+    && live && path && observed !== null && observed < path.homeFraction ? 'Xe đang đến điểm đón' : milestone.label;
+  const retained = milestone.progress === null && progress !== null && !live;
+  const signal = milestone.progress !== null || milestone.inactive ? null
+    : retained ? navigation?.testMode ? 'Vị trí thử nghiệm gần nhất' : 'Vị trí gần nhất · GPS gián đoạn'
+    : live ? navigation?.testMode ? 'Vị trí thử nghiệm' : 'Vị trí GPS'
+    : !telemetry ? 'Đang tải vị trí' : telemetry.unavailable ? 'Chưa tải được vị trí' : !navigation?.latestPosition ? 'Chưa có GPS' : 'Chưa xác định tiến độ';
+
+  useEffect(() => {
+    if (ordered && observed !== null && version && navigation?.latestPosition) {
+      last.current = { version, progress: observed, sequence: navigation.latestPosition.sequence };
+    } else if (last.current?.version !== version) last.current = null;
+  }, [observed, ordered, version, navigation?.latestPosition]);
+
+  // Expire a fix even if the request hangs or the app comes back from the background.
+  useEffect(() => {
+    setExpired(false);
+    if (!navigation?.latestPosition || !receivedAt || !active) return;
+    const serverAge = Date.parse(navigation.serverNow) - Date.parse(navigation.latestPosition.recordedAt);
+    const remaining = 15000 - serverAge - (Date.now() - receivedAt);
+    if (!Number.isFinite(remaining) || remaining <= 0) { setExpired(true); return; }
+    const timer = setTimeout(() => setExpired(true), remaining);
+    return () => clearTimeout(timer);
+  }, [navigation, receivedAt, active]);
+
+  return <StudentJourneyDiagram label={label} progress={progress} outbound={outbound}
+    homeFraction={path?.homeFraction} signal={signal} retained={retained} active={active} />;
+});
+
+type DiagramProps = {
+  label: string;
+  progress: number | null;
+  outbound: boolean;
+  homeFraction?: number;
+  signal: string | null;
+  retained: boolean;
+  active: boolean;
+};
+
+/** Presentation only. Callers must provide observed progress or a confirmed endpoint. */
+export function StudentJourneyDiagram({ label, progress, outbound, homeFraction, signal, retained, active }: DiagramProps) {
+  const reduced = useReducedMotionPreference();
+  const position = useRef(new Animated.Value(0)).current;
+  const pulse = useRef(new Animated.Value(1)).current;
+  const [width, setWidth] = useState(0);
+  const initialized = useRef(false);
+  useEffect(() => {
+    position.stopAnimation();
+    const target = progress ?? 0;
+    if (reduced || !active || !initialized.current) position.setValue(target);
+    else Animated.timing(position, { toValue: target, duration: 600, easing: Easing.out(Easing.cubic), useNativeDriver: true, isInteraction: false }).start();
+    initialized.current = progress !== null;
+    return () => position.stopAnimation();
+  }, [progress, position, reduced, active]);
+
+  useEffect(() => {
+    pulse.stopAnimation(); pulse.setValue(1);
+    if (reduced || !active || !retained) return;
+    const animation = Animated.loop(Animated.sequence([
+      Animated.timing(pulse, { toValue: 0.55, duration: 900, useNativeDriver: true, isInteraction: false }),
+      Animated.timing(pulse, { toValue: 1, duration: 900, useNativeDriver: true, isInteraction: false }),
+    ]));
+    animation.start();
+    return () => { animation.stop(); pulse.setValue(1); };
+  }, [active, reduced, retained, pulse]);
+
+  return (
+    <View style={styles.container} accessible accessibilityRole="image"
+      accessibilityLabel={`${outbound ? 'Chiều đến trường' : 'Chiều về điểm trả'}. ${label}${signal ? `. ${signal}` : ''}`}>
+      <View style={styles.heading}>
+        <View style={styles.headingIcon}><Ionicons name="bus-outline" size={18} color={colors.navigationActive} accessible={false} /></View>
+        <Text style={styles.title}>{label}</Text>
+      </View>
+      <View style={styles.rail} aria-hidden accessible={false} importantForAccessibility="no-hide-descendants" onLayout={e => setWidth(e.nativeEvent.layout.width)}>
+        <View style={styles.track} />
+        {progress !== null && width > 0 && <Animated.View style={[styles.completed, {
+          width, transform: [{ translateX: position.interpolate({ inputRange: [0, 1], outputRange: [-width / 2, 0] }) }, { scaleX: position }],
+        }]} />}
+        <View style={[styles.node, styles.start]}><Ionicons name={outbound ? 'car-outline' : 'school-outline'} size={18} color={colors.mutedText} /></View>
+        {/* The middle stop is placed only when its actual distance along the route is known. */}
+        {outbound && homeFraction !== undefined && homeFraction > 0 && homeFraction < 1 && <View style={[styles.middle, { left: `${homeFraction * 100}%` }]}>
+          <Ionicons name="home-outline" size={16} color={colors.mutedText} />
+        </View>}
+        <View style={[styles.node, styles.end]}><Ionicons name={outbound ? 'school-outline' : 'home-outline'} size={18} color={colors.mutedText} /></View>
+        {progress !== null && <Animated.View style={[styles.bus, { opacity: pulse, transform: [{ translateX: position.interpolate({ inputRange: [0, 1], outputRange: [0, width] }) }] }]}>
+          <Ionicons name="bus" size={20} color={colors.foreground} />
+        </Animated.View>}
+      </View>
+      <View style={styles.labels} accessible={false}>
+        <Text style={styles.endpoint}>{outbound ? 'Điểm xuất phát' : 'Trường học'}</Text>
+        <Text style={[styles.endpoint, styles.endLabel]}>{outbound ? 'Trường học' : 'Điểm trả của con'}</Text>
+      </View>
+      {outbound && homeFraction === undefined && <View style={styles.legend}><Ionicons name="home-outline" size={14} color={colors.mutedText} accessible={false} /><Text style={styles.signal}>Điểm đón của con</Text></View>}
+      {signal && <Text style={styles.signal}>{signal}</Text>}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  container: { padding: 14, borderRadius: 16, backgroundColor: colors.background, gap: 8, borderWidth: 1, borderColor: colors.navigationHighlight },
+  heading: { flexDirection: 'row', alignItems: 'center', gap: 8 },
+  headingIcon: { width: 32, height: 32, borderRadius: 16, alignItems: 'center', justifyContent: 'center', backgroundColor: colors.navigationHighlight },
+  title: { flex: 1, minWidth: 0, fontSize: 14, lineHeight: 21, fontWeight: '700', color: colors.foreground },
+  rail: { marginHorizontal: 16, height: 46, justifyContent: 'center' },
+  track: { height: 6, borderRadius: 3, borderWidth: 1, borderColor: colors.mutedText, backgroundColor: colors.border, width: '100%' },
+  completed: { position: 'absolute', height: 6, borderRadius: 3, borderWidth: 1, borderColor: colors.navigationActive, backgroundColor: colors.primary },
+  node: { position: 'absolute', width: 30, height: 30, borderRadius: 15, backgroundColor: colors.surface, borderWidth: 1, borderColor: colors.border, alignItems: 'center', justifyContent: 'center' },
+  start: { left: -15 }, end: { right: -15 },
+  middle: { position: 'absolute', marginLeft: -12, top: -2, width: 24, height: 22, alignItems: 'center', backgroundColor: colors.background },
+  bus: { position: 'absolute', left: -16, width: 32, height: 32, borderRadius: 12, borderWidth: 2, borderColor: colors.surface, backgroundColor: colors.primary, alignItems: 'center', justifyContent: 'center' },
+  labels: { flexDirection: 'row', justifyContent: 'space-between', gap: 16 },
+  endpoint: { flex: 1, fontSize: 11, lineHeight: 17, color: colors.mutedText },
+  endLabel: { textAlign: 'right' },
+  signal: { color: colors.mutedText, fontSize: 11, lineHeight: 17 },
+  legend: { flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 6 },
+});

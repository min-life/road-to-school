+import { useCallback, useEffect, useRef, useState } from 'react';
+import { AppState } from 'react-native';
+import { useFocusEffect } from 'expo-router';
+import { mobileApiClient, type MobileTripDetail, type ParentHomeCardItem } from '@/services/api-client';
+import { navigationApi, type NavigationState } from '@/services/trip-navigation';
+import { useActiveRefresh } from '@/hooks/use-active-refresh';
+
+export type ParentJourneyTelemetry = {
+  detail?: MobileTripDetail;
+  navigation?: NavigationState;
+  receivedAt?: number;
+  unavailable?: boolean;
+  minimumSequence?: number;
+};
+
+/** Viewer only: one batch per unique trip; never starts a publisher or GPS watcher. */
+export function useParentJourneyTelemetry(identity: string, cards: ParentHomeCardItem[]) {
+  const [active, setActive] = useState(false);
+  useFocusEffect(useCallback(() => {
+    setActive(AppState.currentState === 'active');
+    const subscription = AppState.addEventListener('change', state => setActive(state === 'active'));
+    return () => { setActive(false); subscription.remove(); };
+  }, []));
+  const ids = [...new Set(cards.filter(c => c.tripStatus === 'IN_PROGRESS' && c.attendanceStatus !== 'ABSENT'
+    && !(c.attendanceStatus === 'PRESENT' && c.childIsAlighted)).map(c => c.tripId))].sort();
+  const scope = JSON.stringify([identity, ids]);
+  const [result, setResult] = useState<{ identity: string; trips: Record<string, ParentJourneyTelemetry> }>({ identity, trips: {} });
+  const cache = useRef<{ identity: string; trips: Record<string, ParentJourneyTelemetry> }>({ identity, trips: {} });
+  useEffect(() => {
+    const retained: Record<string, ParentJourneyTelemetry> = {};
+    if (cache.current.identity === identity) for (const id of ids) {
+      if (cache.current.trips[id]) retained[id] = cache.current.trips[id];
+    }
+    cache.current = { identity, trips: retained };
+  }, [scope, identity]);
+  useActiveRefresh(scope, async ({ isCurrent }) => {
+    if (!ids.length) return false;
+    const entries = await Promise.all(ids.map(async id => {
+      const previous = cache.current.identity === identity ? cache.current.trips[id] : undefined;
+      try {
+        const navigation = await navigationApi.state(id);
+        const receivedAt = Date.now();
+        if (!isCurrent()) return null;
+        // Version includes snapshot stops/geometry/assignments. Refresh metadata on change.
+        const detail = previous?.detail && previous.navigation?.routeVersion === navigation.routeVersion
+          ? previous.detail : await mobileApiClient.getMobileTripDetail(id);
+        if (!isCurrent()) return null;
+        const changedRoute = previous?.navigation && previous.navigation.routeVersion !== navigation.routeVersion;
+        const minimumSequence = changedRoute
+          ? Math.max(previous.minimumSequence ?? -1, previous.navigation?.latestPosition?.sequence ?? -1)
+          : previous?.minimumSequence ?? -1;
+        // A route change must not reinterpret the same old fix on a different geometry.
+        const observedNavigation = navigation.latestPosition && navigation.latestPosition.sequence <= minimumSequence
+          ? { ...navigation, freshness: 'STALE' as const } : navigation;
+        return [id, { navigation: observedNavigation, detail, receivedAt, unavailable: false, minimumSequence }] as const;
+      } catch (error: unknown) {
+        if (!isCurrent()) return null;
+        const code = (error as { statusCode?: number })?.statusCode;
+        // Access errors discard the location and route; transient failures freeze the last fix.
+        if (code === 401 || code === 403 || code === 404) return [id, { unavailable: true }] as const;
+        return [id, { ...previous, unavailable: true, navigation: previous?.navigation
+          ? { ...previous.navigation, freshness: 'STALE' as const } : undefined }] as const;
+      }
+    }));
+    if (!isCurrent()) return;
+    const trips: Record<string, ParentJourneyTelemetry> = {};
+    for (const entry of entries) if (entry) trips[entry[0]] = entry[1];
+    cache.current = { identity, trips };
+    setResult({ identity, trips });
+  }, 5000);
+  // Keep unchanged trips steady when a sibling's trip changes; never cross accounts.
+  const trips: Record<string, ParentJourneyTelemetry> = {};
+  if (result.identity === identity) for (const id of ids) {
+    if (result.trips[id]) trips[id] = result.trips[id];
+  }
+  return { trips, active };
+}

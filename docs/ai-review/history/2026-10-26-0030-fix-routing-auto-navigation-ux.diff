+export function splitSegment(coords: Coordinate[], cumulative: number[], progress: number): { traveled: Coordinate[]; remaining: Coordinate[] } {
+  if (coords.length <= 1) return { traveled: [], remaining: [...coords] };
+  const total = cumulative[cumulative.length - 1];
+  if (progress <= 0) return { traveled: [], remaining: [...coords] };
+  if (progress >= total) return { traveled: [...coords], remaining: [] };
+
+  let segIdx = 0;
+  for (let i = 0; i < coords.length - 1; i++) {
+    if (progress <= cumulative[i + 1]) {
+      segIdx = i;
+      break;
+    }
+  }
+  const segDist = cumulative[segIdx + 1] - cumulative[segIdx];
+  const segRatio = segDist > 0 ? (progress - cumulative[segIdx]) / segDist : 0;
+  const splitCoord: Coordinate = [
+    coords[segIdx][0] + (coords[segIdx + 1][0] - coords[segIdx][0]) * segRatio,
+    coords[segIdx][1] + (coords[segIdx + 1][1] - coords[segIdx][1]) * segRatio,
+  ];
+
+  const traveled = [...coords.slice(0, segIdx + 1), splitCoord];
+  const remaining = [splitCoord, ...coords.slice(segIdx + 1)];
+  return { traveled, remaining };
+}

diff --git a/api/src/schools/school-policy.ts b/api/src/schools/school-policy.ts
new file mode 100644
--- /dev/null
+++ b/api/src/schools/school-policy.ts
@@ -0,0 +1,255 @@
+import { ConflictException, UnauthorizedException } from '@nestjs/common';
+import { Prisma, Role, User } from '@prisma/client';
+import {
+  contractDate,
+  isContractExpired,
+  vietnamToday,
+} from './school-effective-state.js';
+import { getDayOfWeekKey } from '../trips/utils/trip-time.util.js';
+import { calendarMatches } from './service-calendar.js';
+
+export type PolicyDb = Pick<
+  Prisma.TransactionClient,
+  'school' | 'schoolScheduledChange' | 'serviceCalendarEntry' | 'trip'
+>;
+export async function effectiveSchool(
+  db: PolicyDb,
+  id: string,
+  date = vietnamToday(),
+) {
+  const school = await db.school.findUnique({ where: { id } });
+  if (!school) return null;
+  const changes = await db.schoolScheduledChange.findMany({
+    where: {
+      schoolId: id,
+      status: 'PENDING',
+      effectiveDate: { lte: new Date(date) },
+    },
+    orderBy: [{ effectiveDate: 'asc' }, { createdAt: 'asc' }],
+  });
+  const result = { ...school };
+  for (const change of changes) {
+    const payload = change.payload as Prisma.JsonObject;
+    if (change.type === 'INACTIVE') result.isActive = false;
+    if (change.type === 'LOCATION') {
+      result.addressText = String(payload.addressText);
+      result.latitude = Number(payload.latitude);
+      result.longitude = Number(payload.longitude);
+    }
+    if (change.type === 'SCHEDULE')
+      result.weeklySchedule = payload.weeklySchedule!;
+  }
+  return result;
+}
+export async function planInvalidation(
+  db: PolicyDb,
+  schoolId: string,
+  createdAt: Date,
+  date = vietnamToday(),
+): Promise<string | null> {
+  const school = await effectiveSchool(db, schoolId, date);
+  if (!school) return 'SCHOOL_INACTIVE';
+  if (isContractExpired(school.contractEndDate, date))
+    return 'CONTRACT_EXPIRED';
+  if (!school.isActive) return 'SCHOOL_INACTIVE';
+  const cutoff = await db.schoolScheduledChange.findFirst({
+    where: {
+      schoolId,
+      type: { in: ['INACTIVE', 'LOCATION'] },
+      status: { in: ['PENDING', 'APPLIED'] },
+      effectiveDate: {
+        lte: new Date(date),
+        gt:
+          new Date(createdAt.getTime() + 7 * 3600000)
+            .toISOString()
+            .slice(0, 10) + 'T00:00:00Z',
+      },
+    },
+  });
+  return cutoff
+    ? cutoff.type === 'LOCATION'
+      ? 'LOCATION_CHANGED'
+      : 'SCHOOL_INACTIVE'
+    : null;
+}
+export async function serviceDay(
+  db: PolicyDb,
+  schoolId: string,
+  date: string,
+  planCreatedAt?: Date,
+) {
+  const school = await effectiveSchool(db, schoolId, date);
+  if (
+    !school ||
+    !school.isActive ||
+    date < contractDate(school.contractStartDate) ||
+    date > contractDate(school.contractEndDate)
+  )
+    return null;
+  if (
+    planCreatedAt &&
+    (await planInvalidation(db, schoolId, planCreatedAt, date))
+  )
+    return null;
+  const entries = await db.serviceCalendarEntry.findMany({
+    where: { status: 'APPROVED', OR: [{ schoolId: null }, { schoolId }] },
+  });
+  const matching = entries.filter((entry) => calendarMatches(entry, date));
+  if (matching.some((entry) => entry.kind === 'HOLIDAY' && !entry.schoolId))
+    return null;
+  const makeup = matching.find(
+    (entry) => entry.kind === 'MAKEUP' && entry.schoolId === schoolId,
+  );
+  if (makeup) return { start: makeup.startTime!, end: makeup.endTime! };
+  if (matching.some((entry) => entry.kind === 'HOLIDAY')) return null;
+  const schedule = school.weeklySchedule as Record<
+    string,
+    { start: string; end: string }
+  >;
+  return schedule[getDayOfWeekKey(date)] ?? null;
+}
+export async function tripBlockReason(
+  db: PolicyDb,
+  id: string,
+): Promise<string | null> {
+  const trip = await db.trip.findUnique({
+    where: { id },
+    include: {
+      school: true,
+      route: { select: { routePlan: { select: { createdAt: true } } } },
+      attendances: true,
+    },
+  });
+  if (!trip || ['COMPLETED', 'CANCELLED'].includes(trip.status)) return null;
+  if ((trip.adminFinalization as Prisma.JsonObject | null)?.state === 'PENDING')
+    return 'ADMIN_FINALIZATION_PENDING';
+  const today = vietnamToday();
+  const invalidation = await planInvalidation(
+    db,
+    trip.schoolId,
+    trip.route.routePlan.createdAt,
+  );
+  if (invalidation) return invalidation;
+  if (
+    contractDate(trip.serviceDate) === today &&
+    !(await serviceDay(db, trip.schoolId, today))
+  )
+    return 'HOLIDAY';
+  if (contractDate(trip.serviceDate) <= today) {
+    const day = contractDate(trip.serviceDate);
+    const entries = await db.serviceCalendarEntry.findMany({
+      where: {
+        status: { in: ['APPROVED', 'CANCELLED'] },
+        OR: [{ schoolId: null }, { schoolId: trip.schoolId }],
+      },
+    });
+    const eligible = entries.filter(
+      (e) =>
+        contractDate(new Date(e.createdAt.getTime() + 7 * 3600000)) < day &&
+        (!e.cancelledAt ||
+          contractDate(new Date(e.cancelledAt.getTime() + 7 * 3600000)) >
+            day) &&
+        calendarMatches(e, day),
+    );
+    const operatorHoliday = eligible.some(
+      (e) => e.kind === 'HOLIDAY' && !e.schoolId,
+    );
+    const schoolHoliday = eligible.some(
+      (e) => e.kind === 'HOLIDAY' && e.schoolId,
+    );
+    const makeup = eligible.some((e) => e.kind === 'MAKEUP');
+    if (operatorHoliday || (schoolHoliday && !makeup)) return 'HOLIDAY';
+  }
+  return null;
+}
+/** Read-only: also rejects old sessions after reactivation even if catch-up was delayed. */
+export async function assertSchoolAccount(
+  db: PolicyDb,
+  user: Pick<User, 'role' | 'schoolId'>,
+  sessionCreatedAt?: Date,
+): Promise<void> {
+  if (
+    ![Role.SCHOOL_ADMIN, Role.BUS_ATTENDANT].includes(
+      user.role as 'SCHOOL_ADMIN' | 'BUS_ATTENDANT',
+    ) ||
+    !user.schoolId
+  )
+    return;
+  const school = await effectiveSchool(db, user.schoolId);
+  if (!school?.isActive)
+    throw new UnauthorizedException(
+      'Trường đã ngừng hoạt động. Vui lòng đăng nhập lại khi trường hoạt động',
+    );
+  if (sessionCreatedAt) {
+    const past = await db.schoolScheduledChange.findMany({
+      where: {
+        schoolId: user.schoolId,
+        type: 'INACTIVE',
+        status: { in: ['PENDING', 'APPLIED'] },
+        effectiveDate: { lte: new Date(vietnamToday()) },
+      },
+    });
+    if (
+      past.some(
+        (change) =>
+          sessionCreatedAt <
+          new Date(`${contractDate(change.effectiveDate)}T00:00:00+07:00`),
+      )
+    )
+      throw new UnauthorizedException(
+        'Trường đã hoạt động lại. Vui lòng đăng nhập mới',
+      );
+  }
+}
+export async function assertTripPolicy(
+  db: PolicyDb,
+  id: string,
+): Promise<void> {
+  if (await tripBlockReason(db, id))
+    throw new ConflictException(
+      'Chuyến không còn đủ điều kiện vận hành; cần quản trị viên chốt trạng thái',
+    );
+}
+
+export async function tripPolicyEffectiveDate(
+  db: PolicyDb,
+  id: string,
+  reason: string,
+): Promise<string> {
+  const trip = await db.trip.findUniqueOrThrow({
+    where: { id },
+    include: {
+      school: true,
+      route: { select: { routePlan: { select: { createdAt: true } } } },
+    },
+  });
+  if (reason === 'CONTRACT_EXPIRED')
+    return contractDate(
+      new Date(trip.school.contractEndDate.getTime() + 86400000),
+    );
+  if (reason === 'HOLIDAY') return contractDate(trip.serviceDate);
+  const change = await db.schoolScheduledChange.findFirst({
+    where: {
+      schoolId: trip.schoolId,
+      type: reason === 'LOCATION_CHANGED' ? 'LOCATION' : 'INACTIVE',
+      status: { in: ['PENDING', 'APPLIED'] },
+      effectiveDate: {
+        lte: new Date(vietnamToday()),
+        gt: new Date(
+          new Date(trip.route.routePlan.createdAt.getTime() + 7 * 3600000)
+            .toISOString()
+            .slice(0, 10),
+        ),
+      },
+    },
+    orderBy: { effectiveDate: 'asc' },
+  });
+  return change ? contractDate(change.effectiveDate) : vietnamToday();
+}
+
+export async function assertSchoolWritable(db: PolicyDb, schoolId: string) {
+  if (!(await effectiveSchool(db, schoolId))?.isActive)
+    throw new ConflictException(
+      'Trường đã ngừng hoạt động; chỉ được xem dữ liệu cũ',
+    );
+}
diff --git a/api/src/schools/service-calendar.service.ts b/api/src/schools/service-calendar.service.ts
new file mode 100644
--- /dev/null
+++ b/api/src/schools/service-calendar.service.ts
@@ -0,0 +1,289 @@
+import { effectiveSchool } from './school-policy.js';
+import {
+  BadRequestException,
+  ConflictException,
+  ForbiddenException,
+  Injectable,
+  NotFoundException,
+} from '@nestjs/common';
+import { Prisma, ServiceCalendarEntry, User } from '@prisma/client';
+import { PrismaService } from '../prisma/prisma.service.js';
+import {
+  CreateCalendarEntryDto,
+  CalendarDecisionDto,
+} from './dto/service-calendar.dto.js';
+import { calendarMatches, calendarOccurrence } from './service-calendar.js';
+import { contractDate, vietnamToday } from './school-effective-state.js';
+import {
+  adminRecipients,
+  writeNotification,
+} from '../notifications/notification-writer.js';
+
+@Injectable()
+export class ServiceCalendarService {
+  constructor(private readonly prisma: PrismaService) {}
+  private access(actor: User, schoolId: string | null) {
+    if (
+      actor.role !== 'SYSTEM_ADMIN' &&
+      !(
+        actor.role === 'SCHOOL_ADMIN' &&
+        schoolId &&
+        schoolId === actor.schoolId
+      )
+    )
+      throw new ForbiddenException('Không có quyền quản lý lịch này');
+  }
+  private async lock(tx: Prisma.TransactionClient) {
+    // Shared transaction lock prevents holiday insertion racing makeup approval.
+    await tx.$queryRaw(Prisma.sql`SELECT pg_advisory_xact_lock(3202032)`);
+  }
+  async list(actor: User, schoolId?: string) {
+    if (schoolId) this.access(actor, schoolId);
+    const scope = actor.role === 'SCHOOL_ADMIN' ? actor.schoolId : schoolId;
+    if (!['SYSTEM_ADMIN', 'SCHOOL_ADMIN'].includes(actor.role))
+      throw new ForbiddenException();
+    const rows = await this.prisma.serviceCalendarEntry.findMany({
+      where: scope ? { OR: [{ schoolId: scope }, { schoolId: null }] } : {},
+      orderBy: { createdAt: 'desc' },
+    });
+    return Promise.all(rows.map((row) => this.effective(row)));
+  }
+  private async effective(entry: ServiceCalendarEntry) {
+    let blocked = false;
+    if (entry.kind === 'MAKEUP' && entry.status === 'APPROVED') {
+      const date = calendarOccurrence(entry, entry.year!);
+      const holidays = await this.prisma.serviceCalendarEntry.findMany({
+        where: { schoolId: null, kind: 'HOLIDAY', status: 'APPROVED' },
+      });
+      blocked = Boolean(date && holidays.some((h) => calendarMatches(h, date)));
+    }
+    return {
+      ...entry,
+      effectiveStatus: blocked ? 'BLOCKED' : entry.status,
+      effectiveStatusReason: blocked ? 'OPERATOR_HOLIDAY' : null,
+    };
+  }
+  private async assertMakeup(
+    tx: Prisma.TransactionClient,
+    entry: CreateCalendarEntryDto | ServiceCalendarEntry,
+  ) {
+    const date = calendarOccurrence(
+      {
+        ...entry,
+        year: entry.year ?? null,
+        leapMonth: entry.leapMonth ?? false,
+      },
+      entry.year!,
+    );
+    if (!date || date <= vietnamToday())
+      throw new BadRequestException('Học bù phải vào ngày hợp lệ sau hôm nay');
+    const school = await effectiveSchool(tx, entry.schoolId!, date);
+    if (
+      !school ||
+      !school.isActive ||
+      date < contractDate(school.contractStartDate) ||
+      date > contractDate(school.contractEndDate)
+    )
+      throw new BadRequestException(
+        'Ngày học bù phải thuộc hợp đồng trường hoạt động',
+      );
+    const holidays = await tx.serviceCalendarEntry.findMany({
+      where: { schoolId: null, status: 'APPROVED', kind: 'HOLIDAY' },
+    });
+    if (holidays.some((h) => calendarMatches(h, date)))
+      throw new ConflictException('Học bù trùng ngày nghỉ nhà xe');
+    const other = await tx.serviceCalendarEntry.findMany({
+      where: {
+        schoolId: entry.schoolId,
+        kind: 'MAKEUP',
+        status: { in: ['APPROVED', 'PENDING'] },
+      },
+    });
+    if (
+      other.some(
+        (e) =>
+          (!('id' in entry) || e.id !== entry.id) && calendarMatches(e, date),
+      )
+    )
+      throw new ConflictException('Đã có yêu cầu học bù trong ngày này');
+    return date;
+  }
+  async create(dto: CreateCalendarEntryDto, actor: User) {
+    if (dto.kind === 'MAKEUP' && actor.role !== 'SCHOOL_ADMIN')
+      throw new ForbiddenException('Trường đề nghị học bù, nhà xe duyệt');
+    const schoolId = dto.schoolId ?? null;
+    this.access(actor, schoolId);
+    if (
+      dto.kind === 'MAKEUP' &&
+      (!schoolId ||
+        dto.recurrence !== 'ONCE' ||
+        !dto.startTime ||
+        !dto.endTime ||
+        dto.startTime >= dto.endTime)
+    )
+      throw new BadRequestException(
+        'Học bù cần trường, năm cụ thể và giờ bắt đầu < giờ kết thúc',
+      );
+    if (dto.calendar === 'SOLAR' && dto.leapMonth)
+      throw new BadRequestException('Lịch dương không có tháng nhuận');
+    if ((dto.recurrence === 'ONCE') !== (dto.year != null))
+      throw new BadRequestException('ONCE cần năm; ANNUAL không nhận năm');
+    if (dto.kind === 'HOLIDAY' && (dto.startTime || dto.endTime))
+      throw new BadRequestException('Ngày nghỉ không nhận giờ học');
+    return this.prisma
+      .$transaction(async (tx) => {
+        await this.lock(tx);
+        if (
+          schoolId &&
+          !(await tx.school.findUnique({ where: { id: schoolId } }))
+        )
+          throw new NotFoundException('Không tìm thấy trường');
+        const candidate = {
+          ...dto,
+          year: dto.year ?? null,
+          leapMonth: dto.leapMonth ?? false,
+        };
+        if (dto.recurrence === 'ONCE') {
+          const date = calendarOccurrence(candidate, dto.year!);
+          if (!date || date <= vietnamToday())
+            throw new BadRequestException(
+              'Ngày nghỉ phải tồn tại và báo trước hôm nay',
+            );
+        } else {
+          // Recurrences whose day is absent in a particular year skip that occurrence.
+          const years = Array.from({ length: 300 }, (_, i) => 1900 + i);
+          if (!years.some((y) => calendarOccurrence(candidate, y)))
+            throw new BadRequestException('Ngày lặp không hợp lệ');
+          if (calendarMatches(candidate, vietnamToday()))
+            throw new BadRequestException(
+              'Không thêm ngày nghỉ áp dụng hôm nay',
+            );
+        }
+        if (dto.kind === 'MAKEUP') await this.assertMakeup(tx, dto);
+        const entry = await tx.serviceCalendarEntry.create({
+          data: {
+            ...dto,
+            schoolId,
+            leapMonth: dto.leapMonth ?? false,
+            status: dto.kind === 'MAKEUP' ? 'PENDING' : 'APPROVED',
+            createdById: actor.id,
+          },
+        });
+        if (dto.kind === 'MAKEUP')
+          await this.notify(
+            tx,
+            entry,
+            'requested',
+            await adminRecipients(tx, 'SYSTEM_ADMIN'),
+            actor.id,
+          );
+        if (!schoolId && dto.kind === 'HOLIDAY') {
+          const makeups = await tx.serviceCalendarEntry.findMany({
+            where: { kind: 'MAKEUP', status: 'APPROVED' },
+          });
+          for (const makeup of makeups) {
+            const date = calendarOccurrence(makeup, makeup.year!);
+            if (date && date > vietnamToday() && calendarMatches(entry, date))
+              await this.notify(
+                tx,
+                entry,
+                `blocked:${makeup.id}`,
+                await adminRecipients(tx, 'SCHOOL_ADMIN', makeup.schoolId!),
+                actor.id,
+              );
+          }
+        }
+        return entry;
+      })
+      .then((entry) => this.effective(entry));
+  }
+  private async notify(
+    tx: Prisma.TransactionClient,
+    entry: ServiceCalendarEntry,
+    action: string,
+    userIds: string[],
+    actorId: string,
+  ) {
+    await writeNotification(tx, {
+      eventKey: `calendar:${entry.id}:${action}`,
+      type: 'SERVICE_CALENDAR_CHANGED',
+      title: action.startsWith('blocked')
+        ? 'Ngày học bù bị chặn bởi lịch nghỉ nhà xe'
+        : 'Lịch dịch vụ đã cập nhật',
+      body: entry.title,
+      targetType: 'SCHEDULE',
+      targetId: 'current',
+      userIds,
+      actorId,
+    });
+  }
+  async decide(id: string, dto: CalendarDecisionDto, actor: User) {
+    if (actor.role !== 'SYSTEM_ADMIN')
+      throw new ForbiddenException('Chỉ nhà xe được duyệt học bù');
+    if (dto.status === 'REJECTED' && !dto.reason?.trim())
+      throw new BadRequestException('Cần lý do từ chối');
+    return this.prisma
+      .$transaction(async (tx) => {
+        await this.lock(tx);
+        const entry = await tx.serviceCalendarEntry.findUnique({
+          where: { id },
+        });
+        if (!entry) throw new NotFoundException('Không tìm thấy lịch');
+        if (entry.kind !== 'MAKEUP' || entry.status !== 'PENDING')
+          throw new ConflictException('Chỉ duyệt yêu cầu học bù còn chờ');
+        const date = calendarOccurrence(entry, entry.year!);
+        if (!date || date <= vietnamToday())
+          throw new ConflictException('Yêu cầu đã đến ngày hoặc không hợp lệ');
+        if (dto.status === 'APPROVED') await this.assertMakeup(tx, entry);
+        const updated = await tx.serviceCalendarEntry.update({
+          where: { id },
+          data: {
+            status: dto.status,
+            reviewedById: actor.id,
+            reviewedAt: new Date(),
+            reason: dto.reason,
+          },
+        });
+        await this.notify(
+          tx,
+          updated,
+          dto.status,
+          await adminRecipients(tx, 'SCHOOL_ADMIN', entry.schoolId!),
+          actor.id,
+        );
+        return updated;
+      })
+      .then((entry) => this.effective(entry));
+  }
+  async cancel(id: string, actor: User) {
+    return this.prisma
+      .$transaction(async (tx) => {
+        await this.lock(tx);
+        const entry = await tx.serviceCalendarEntry.findUnique({
+          where: { id },
+        });
+        if (!entry) throw new NotFoundException('Không tìm thấy lịch');
+        this.access(actor, entry.schoolId);
+        if (entry.kind !== 'HOLIDAY')
+          throw new BadRequestException(
+            'Hủy học bù chưa thuộc contract được duyệt',
+          );
+        if (entry.status !== 'APPROVED')
+          throw new ConflictException('Lịch không còn hiệu lực');
+        const date =
+          entry.recurrence === 'ONCE'
+            ? calendarOccurrence(entry, entry.year!)
+            : null;
+        if (
+          (date && date <= vietnamToday()) ||
+          calendarMatches(entry, vietnamToday())
+        )
+          throw new ConflictException('Không hủy lịch đã đến ngày');
+        return tx.serviceCalendarEntry.update({
+          where: { id },
+          data: { status: 'CANCELLED', cancelledAt: new Date() },
+        });
+      })
+      .then((entry) => this.effective(entry));
+  }
+}
diff --git a/api/src/schools/service-calendar.ts b/api/src/schools/service-calendar.ts
new file mode 100644
--- /dev/null
+++ b/api/src/schools/service-calendar.ts
@@ -0,0 +1,74 @@
+import { createRequire } from 'node:module';
+import type { ServiceCalendarEntry } from '@prisma/client';
+
+const lunar = createRequire(import.meta.url)('amlich.js') as {
+  computeDateToLunarDate(
+    d: number,
+    m: number,
+    y: number,
+    tz: number,
+  ): {
+    lunarDay: number;
+    lunarMonth: number;
+    lunarYear: number;
+    lunarLeap: number;
+  };
+  computeDateFromLunarDate(
+    d: number,
+    m: number,
+    y: number,
+    leap: number,
+    tz: number,
+  ): { day: number; month: number; year: number } | number[];
+};
+type CalendarDate = Pick<
+  ServiceCalendarEntry,
+  'calendar' | 'year' | 'month' | 'day' | 'leapMonth' | 'recurrence'
+>;
+export function calendarMatches(entry: CalendarDate, date: string): boolean {
+  const [year, month, day] = date.split('-').map(Number);
+  if (entry.calendar === 'SOLAR')
+    return (
+      entry.month === month &&
+      entry.day === day &&
+      (entry.recurrence === 'ANNUAL' || entry.year === year)
+    );
+  const value = lunar.computeDateToLunarDate(day, month, year, 7);
+  return (
+    entry.month === value.lunarMonth &&
+    entry.day === value.lunarDay &&
+    Number(entry.leapMonth) === value.lunarLeap &&
+    (entry.recurrence === 'ANNUAL' || entry.year === value.lunarYear)
+  );
+}
+/** Round-trip rejects library normalization of nonexistent days/months. */
+export function calendarOccurrence(
+  entry: CalendarDate,
+  year: number,
+): string | null {
+  let y = year,
+    m = entry.month,
+    d = entry.day;
+  if (entry.calendar === 'LUNAR') {
+    const value = lunar.computeDateFromLunarDate(
+      d,
+      m,
+      y,
+      Number(entry.leapMonth),
+      7,
+    );
+    if (Array.isArray(value)) return null;
+    // amlich.js returns a zero-based solar month.
+    y = value.year;
+    m = value.month + 1;
+    d = value.day;
+  }
+  const result = `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
+  const parsed = new Date(`${result}T00:00:00Z`);
+  if (
+    !Number.isFinite(parsed.getTime()) ||
+    parsed.toISOString().slice(0, 10) !== result
+  )
+    return null;
+  return calendarMatches(entry, result) ? result : null;
+}

+import { StyleSheet, Text, TouchableOpacity, View } from 'react-native';
+import Ionicons from '@expo/vector-icons/Ionicons';
+import { UserAvatar } from '@/components/user-avatar';
+import { colors } from '@/constants/theme';
+import type { ParentLinkedStudentItem } from '@/services/api-client';
+
+type Props = {
+  student?: Pick<ParentLinkedStudentItem, 'fullName' | 'avatarUrl' | 'schoolName' | 'code'>;
+  fixed: boolean;
+  onPress: () => void;
+};
+
+/** A linked child's identity; selection and fixed-student behavior stay with the screen. */
+export function LeaveStudentCard({ student, fixed, onPress }: Props) {
+  const name = student?.fullName || (fixed ? 'Học sinh' : 'Chọn học sinh');
+  const identity = <>
+    <View style={styles.avatarFrame}>
+      <UserAvatar avatarUrl={student?.avatarUrl} fullName={student?.fullName || 'Học sinh'} size={48} />
+    </View>
+    <View style={styles.identity}>
+      <Text style={styles.name}>{name}</Text>
+      {!!student?.schoolName && <Text style={styles.school}>{student.schoolName}</Text>}
+      {(student?.code || fixed) && <View style={styles.details}>
+        {!!student?.code && <View style={styles.codeRow}>
+          <Ionicons name="id-card-outline" size={13} color={colors.mutedText} accessible={false} />
+          <Text style={styles.code}>Mã: {student.code}</Text>
+        </View>}
+        {fixed && <View style={styles.fixedBadge}>
+          <Ionicons name="lock-closed-outline" size={11} color={colors.mutedText} accessible={false} />
+          <Text style={styles.fixedText}>Cố định</Text>
+        </View>}
+      </View>}
+    </View>
+    {!fixed && <View style={styles.chevron}>
+      <Ionicons name="chevron-down" size={18} color={colors.navigationActive} accessible={false} />
+    </View>}
+  </>;
+
+  return fixed ? <View style={styles.card}>{identity}</View> : (
+    <TouchableOpacity style={styles.card} activeOpacity={0.8} onPress={onPress}
+      accessibilityRole="button" accessibilityLabel={[name, student?.schoolName, student?.code && `Mã: ${student.code}`].filter(Boolean).join(', ')}
+      accessibilityHint="Mở danh sách chọn học sinh">
+      {identity}
+    </TouchableOpacity>
+  );
+}
+
+const styles = StyleSheet.create({
+  card: { flexDirection: 'row', alignItems: 'center', gap: 12, padding: 16, backgroundColor: colors.surface,
+    borderWidth: 1, borderColor: colors.border, borderRadius: 20, shadowColor: colors.navigationShadow,
+    shadowOffset: { width: 0, height: 1 }, shadowOpacity: 0.04, shadowRadius: 4, elevation: 1 },
+  avatarFrame: { padding: 2, borderRadius: 27, borderWidth: 1, borderColor: colors.navigationHighlight,
+    backgroundColor: colors.background, flexShrink: 0 },
+  identity: { flex: 1, minWidth: 0, gap: 4 },
+  name: { fontSize: 16, lineHeight: 22, fontWeight: '700', color: colors.foreground },
+  school: { fontSize: 12, lineHeight: 18, color: colors.mutedText },
+  details: { flexDirection: 'row', flexWrap: 'wrap', alignItems: 'center', gap: 6, marginTop: 2 },
+  codeRow: { flexDirection: 'row', alignItems: 'center', gap: 4, flexShrink: 1, minWidth: 0 },
+  code: { fontSize: 11, lineHeight: 16, color: colors.mutedText, flexShrink: 1 },
+  fixedBadge: { flexDirection: 'row', alignItems: 'center', gap: 4, backgroundColor: '#F1F5F9',
+    borderRadius: 8, paddingHorizontal: 7, paddingVertical: 3 },
+  fixedText: { fontSize: 11, fontWeight: '600', color: colors.mutedText },
+  chevron: { width: 32, height: 32, borderRadius: 16, backgroundColor: colors.navigationHighlight,
+    alignItems: 'center', justifyContent: 'center', flexShrink: 0 },
+});

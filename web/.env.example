NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
PORT=5173

# ==============================================================================
# VIETMAP CREDENTIALS (BROWSER-FIRST DIRECT INTEGRATION)
# ==============================================================================
# 1. Services API Key (Autocomplete, Place Details, Reverse Geocoding)
#    Yêu cầu bảo mật: Phải cấu hình trong VietMap Console với:
#    - Giới hạn Domain (HTTP Referer whitelist, ví dụ: *.roadtoschool.vn, localhost:5173)
#    - Giới hạn tính năng API (chỉ bật Autocomplete, Place, Reverse; tắt Routing/Matrix/TSP)
#    - Giới hạn hạn ngạch (Quota / Rate Limiting)
NEXT_PUBLIC_VIETMAP_SERVICES_KEY=

# 2. Tilemap Key (MapLibre Vector Tiles for Web Map Picker)
#    Yêu cầu bảo mật: Phải cấu hình Giới hạn Domain (Domain Restrictions)
NEXT_PUBLIC_VIETMAP_TILEMAP_KEY=
